import EmbeddingDimensionStrata.NormalCoordinates

/-!
# The genuine normal-coordinate parameter locus

The locus is defined by the value semigroup of the algebra actually generated
in `K[t]/(t^60)`, not by a rank table or an assumed list of equations.
-/
noncomputable section
namespace EmbeddingDimensionStrata
variable {K : Type*} [Field K]

/-- The actual jet subalgebra generated by a coefficient point. -/
def parameterJetAlgebra (p : NormalCoordinate → K) : Subalgebra K (Jet K 60) :=
  Algebra.adjoin K (Set.range fun i : Fin 5 => jetMap K 60 (normalSeries p i))

/-- Hamilton's normal-form locus, before identifying its defining equations. -/
def ParameterSpace :=
  {p : NormalCoordinate → K // ∀ n, JetHasValue (parameterJetAlgebra p) n ↔ Gamma n}

variable [TopologicalSpace K]
open scoped PowerSeries.WithPiTopology

theorem parameterJetAlgebra_normalCoordinates (S : CompleteGammaSubalgebra (K := K)) :
    parameterJetAlgebra (normalCoordinates S) = S.val.map (jetMap K 60) := by
  have hfun : (fun i : Fin 5 => jetMap K 60 (normalSeries (normalCoordinates S) i)) =
      (fun i : Fin 5 => jetMap K 60 (normalGenerator S i)) := by
    funext i
    rw [normalSeries_normalCoordinates]
  rw [parameterJetAlgebra, hfun, Set.range_comp', ← AlgHom.map_adjoin]
  exact normalGeneratorAlgebra_jet S

/-- Assigning the 62 canonical coefficients lands in the actual parameter locus. -/
def toParameterSpace (S : CompleteGammaSubalgebra (K := K)) : ParameterSpace (K := K) := by
  refine ⟨normalCoordinates S, ?_⟩
  rw [parameterJetAlgebra_normalCoordinates]
  exact (toGammaJet S).property

variable [DiscreteTopology K]

/-- Reconstructing a complete subalgebra from a genuine parameter point. -/
def fromParameterSpace (p : ParameterSpace (K := K)) : CompleteGammaSubalgebra (K := K) :=
  fromGammaJet ⟨parameterJetAlgebra p.val, p.property⟩

theorem normalGenerator_fromParameterSpace (p : ParameterSpace (K := K)) (i : Fin 5) :
    normalGenerator (fromParameterSpace p) i = normalSeries p.val i := by
  apply normalForm_unique (fromParameterSpace p).val (fromParameterSpace p).property.2
    (normalGenerator_mem _ i) _ (normalGenerator_normal _ i) (normalSeries_normal _ i)
  change jetMap K 60 (normalSeries p.val i) ∈ parameterJetAlgebra p.val
  exact Algebra.subset_adjoin (Set.mem_range_self i)

theorem normalCoordinates_fromParameterSpace (p : ParameterSpace (K := K)) :
    normalCoordinates (fromParameterSpace p) = p.val := by
  funext j
  rw [normalCoordinates, normalGenerator_fromParameterSpace, coeff_normalSeries_coordinate]

/-- A proved bijection between actual complete Γ-subalgebras and the genuine
62-coordinate parameter locus. No affine-space or rank conclusion is assumed. -/
def completeGammaParameterEquiv :
    CompleteGammaSubalgebra (K := K) ≃ ParameterSpace (K := K) where
  toFun := toParameterSpace
  invFun := fromParameterSpace
  left_inv S := by
    apply normalCoordinates_injective
    exact normalCoordinates_fromParameterSpace (toParameterSpace S)
  right_inv p := by
    apply Subtype.ext
    exact normalCoordinates_fromParameterSpace p

end EmbeddingDimensionStrata
