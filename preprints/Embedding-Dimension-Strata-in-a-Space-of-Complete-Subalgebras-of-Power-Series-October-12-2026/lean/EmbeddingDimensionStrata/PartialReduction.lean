import EmbeddingDimensionStrata.PolynomialOpenObstructions

/-! # The actual partial reduction used in Question 4.7 -/
set_option maxRecDepth 4096
noncomputable section
namespace EmbeddingDimensionStrata
open Classical

/-- The semigroup generated by the first four normal-form orders. -/
def FirstFourValue (n : ℕ) : Prop :=
  ∃ a : Exponent, a.2.2.2.2 = 0 ∧ monomialWeight a = n

theorem firstFourValue_below_sixty (n : ℕ) (hn : n < 60) :
    FirstFourValue n ↔ n ∈ valuesBelowConductor ∧ n ≠ 58 := by
  constructor
  · rintro ⟨a,ha,rfl⟩
    have hs := (mem_smallExponents_iff a).mpr hn
    have hnot : ∀ a ∈ smallExponents, a.2.2.2.2 = 0 → monomialWeight a ≠ 58 := by decide
    refine ⟨(gamma_below_conductor hn).mp ?_,hnot a hs ha⟩
    exact ⟨a.1,a.2.1,a.2.2.1,a.2.2.2.1,a.2.2.2.2,rfl⟩
  · rintro ⟨hg,h58⟩
    have hf : ∀ n ∈ valuesBelowConductor, n ≠ 58 → (basisExponent n).2.2.2.2 = 0 := by decide
    exact ⟨basisExponent n,hf n hg h58,basisExponent_weight n hg⟩

section Ring
variable {A : Type*} [CommRing A]

/-- Positive-order monomial division by the first four generators. In the
60-jet the only omitted semigroup orders are 0 and 58. -/
def partialReduceSeries (p : NormalCoordinate → A) : ℕ → PowerSeries A →ₗ[A] PowerSeries A
  | 0 => LinearMap.id
  | n+1 => (if n = 0 ∨ n = 58 then LinearMap.id else reductionStep p n).comp
      (partialReduceSeries p n)

theorem partialReduceSeries_succ (p : NormalCoordinate → A) (n : ℕ) (f : PowerSeries A) :
    partialReduceSeries p (n+1) f =
      if n = 0 ∨ n = 58 then partialReduceSeries p n f
      else reductionStep p n (partialReduceSeries p n f) := by
  by_cases h : n = 0 ∨ n = 58 <;> simp [partialReduceSeries, h]

/-- Each active step is exactly subtraction of the current coefficient times
a monic monomial in X,H,Z,W; the pivot set is T∩[1,59]. -/
theorem partialReduceSeries_monomial_step (p : NormalCoordinate → A) (n : ℕ) (hn : n < 60)
    (f : PowerSeries A) :
    partialReduceSeries p (n+1) f =
      if 0 < n ∧ FirstFourValue n then
        partialReduceSeries p n f - PowerSeries.coeff n (partialReduceSeries p n f) • basisSeries p n
      else partialReduceSeries p n f := by
  classical
  rw [partialReduceSeries_succ, firstFourValue_below_sixty n hn]
  by_cases hz : n = 0
  · subst n; simp
  · by_cases h58 : n = 58
    · subst n; simp
    · by_cases hg : n ∈ valuesBelowConductor
      · simp [hz,h58,hg,reductionStep,Nat.pos_of_ne_zero hz]
      · simp [hz,h58,hg,reductionStep]

theorem partial_basis_uses_first_four (n : ℕ) (hn : n < 60) (hT : FirstFourValue n) :
    (basisExponent n).2.2.2.2 = 0 := by
  have hf : ∀ n ∈ valuesBelowConductor, n ≠ 58 → (basisExponent n).2.2.2.2 = 0 := by decide
  have hh := (firstFourValue_below_sixty n hn).mp hT
  exact hf n hh.1 hh.2

theorem basisSeries_zero (p : NormalCoordinate → A) : basisSeries p 0 = 1 := by
  simp [basisSeries, basisExponent, seriesMonomial]

theorem reductionStep_constant (p : NormalCoordinate → A) (n : ℕ) (hn : 0 < n) (a : A) :
    reductionStep p n (PowerSeries.C a) = PowerSeries.C a := by
  by_cases hg : n ∈ valuesBelowConductor
  · simp [reductionStep, hg, PowerSeries.coeff_C, ne_of_gt hn]
  · simp [reductionStep,hg]

theorem partialReduceSeries_initial (p : NormalCoordinate → A) (f : PowerSeries A)
    (N : ℕ) (hN : N < 58) :
    partialReduceSeries p (N+1) f = reduceSeries p (N+1) f + PowerSeries.C (PowerSeries.coeff 0 f) := by
  induction N with
  | zero =>
    rw [partialReduceSeries_succ, ite_eq_left (Or.inl rfl), reduceSeries_succ,
      ite_eq_left (by decide : 0 ∈ valuesBelowConductor), reduceSeries_zero, basisSeries_zero]
    change f = f - PowerSeries.coeff 0 f • 1 + PowerSeries.C (PowerSeries.coeff 0 f)
    rw [Algebra.smul_def, mul_one]
    exact (sub_add_cancel f _).symm
  | succ n ih =>
    rw [partialReduceSeries_succ, ite_eq_right (by omega), ih (by omega), map_add,
      reductionStep_constant p (n+1) (by omega)]
    rfl

/-- The increasing positive-order algorithm is exactly full division below58
with the unchanged constant term restored. -/
theorem partialReduceSeries_sixty (p : NormalCoordinate → A) (f : PowerSeries A) :
    partialReduceSeries p 60 f = reduceSeries p 58 f + PowerSeries.C (PowerSeries.coeff 0 f) := by
  rw [partialReduceSeries_succ, ite_eq_right (by omega)]
  have h59 : reductionStep p 59 = LinearMap.id := by
    rw [reductionStep, ite_eq_right (by decide)]
  rw [h59, LinearMap.id_apply, partialReduceSeries_succ, ite_eq_left (Or.inr rfl)]
  exact partialReduceSeries_initial p f 57 (by omega)

theorem partialReduceSeries_constant (p : NormalCoordinate → A) (f : PowerSeries A) :
    PowerSeries.coeff 0 (partialReduceSeries p 60 f) = PowerSeries.coeff 0 f := by
  rw [partialReduceSeries_sixty, map_add,
    coeff_reduceSeries_eq_zero p f 58 (by omega) (by decide), PowerSeries.coeff_zero_C, zero_add]

theorem partialReduceSeries_killed (p : NormalCoordinate → A) (f : PowerSeries A)
    (n : ℕ) (hn : n ∈ valuesBelowConductor) (hpos : 0 < n) (h58 : n < 58) :
    PowerSeries.coeff n (partialReduceSeries p 60 f) = 0 := by
  rw [partialReduceSeries_sixty, map_add, coeff_reduceSeries_eq_zero p f 58 h58 hn,
    PowerSeries.coeff_C, ite_eq_right (ne_of_gt hpos), add_zero]

/-- Reduction commutes with every coefficient-ring homomorphism. -/
theorem map_partialReduceSeries {B : Type*} [CommRing B] (φ : A →+* B)
    (p : NormalCoordinate → A) (f : PowerSeries A) :
    PowerSeries.map φ (partialReduceSeries p 60 f) =
      partialReduceSeries (fun j => φ (p j)) 60 (PowerSeries.map φ f) := by
  rw [partialReduceSeries_sixty, partialReduceSeries_sixty, map_add, map_reduceSeries]
  simp only [PowerSeries.map_C, PowerSeries.coeff_map]

end Ring
section Field
variable {K : Type*} [Field K]

theorem partialReduceSeries_mem (p : NormalCoordinate → K) (f : PowerSeries K)
    (hf : jetMap K 60 f ∈ parameterJetAlgebra p) :
    jetMap K 60 (partialReduceSeries p 60 f) ∈ parameterJetAlgebra p := by
  have hr := basisJetSpace_le p (jet_sub_reduceSeries_mem p f 58)
  rw [map_sub] at hr
  have hred := (parameterJetAlgebra p).sub_mem hf hr
  rw [sub_sub_cancel] at hred
  rw [partialReduceSeries_sixty, map_add]
  exact (parameterJetAlgebra p).add_mem hred ((parameterJetAlgebra p).algebraMap_mem _)

/-- Semigroup membership rules out every residual order below58 once the
constant coefficient vanishes. -/
theorem partialReduceSeries_low (p : ParameterSpace (K := K)) (f : PowerSeries K)
    (hf : jetMap K 60 f ∈ parameterJetAlgebra p.val) (h0 : PowerSeries.coeff 0 f = 0) :
    ∀ n < 58, PowerSeries.coeff n (partialReduceSeries p.val 60 f) = 0 := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro hn
    by_cases hn0 : n = 0
    · subst n
      exact (partialReduceSeries_constant p.val f).trans h0
    · by_contra hz
      have ho : HasOrder (partialReduceSeries p.val 60 f) n :=
        ⟨fun i hi => ih i hi (by omega),hz⟩
      have hg := (p.property n).mp (Or.inr ⟨by omega,_,partialReduceSeries_mem p.val f hf,ho⟩)
      exact hz (partialReduceSeries_killed p.val f n ((gamma_below_conductor (by omega)).mp hg)
        (by omega) hn)

theorem partialReduceSeries_order58_iff (p : ParameterSpace (K := K)) (f : PowerSeries K)
    (hf : jetMap K 60 f ∈ parameterJetAlgebra p.val) (h0 : PowerSeries.coeff 0 f = 0) :
    HasOrder (partialReduceSeries p.val 60 f) 58 ↔
      PowerSeries.coeff 58 (partialReduceSeries p.val 60 f) ≠ 0 := by
  exact ⟨And.right,fun h => ⟨partialReduceSeries_low p f hf h0,h⟩⟩

end Field
end EmbeddingDimensionStrata
