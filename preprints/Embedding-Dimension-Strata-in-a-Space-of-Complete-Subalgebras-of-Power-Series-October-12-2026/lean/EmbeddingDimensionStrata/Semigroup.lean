import Mathlib.Algebra.Group.Submonoid.Defs
import Mathlib.Data.Finset.Basic
import Lean.Elab.Tactic.Omega
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Ring
import Mathlib.Tactic.IntervalCases

/-!
# The value semigroup ⟨10, 11, 34, 46, 58⟩

This is the additive semigroup of actual nonnegative integer combinations,
with no upper bound on the coefficients or on its elements.
-/
namespace EmbeddingDimensionStrata

/-- Membership in the semigroup generated by the five specified values. -/
def Gamma (n : ℕ) : Prop :=
  ∃ a b c d e : ℕ, n = 10 * a + 11 * b + 34 * c + 46 * d + 58 * e

theorem gamma_zero : Gamma 0 := ⟨0, 0, 0, 0, 0, by omega⟩

theorem gamma_add {m n : ℕ} (hm : Gamma m) (hn : Gamma n) : Gamma (m + n) := by
  obtain ⟨a, b, c, d, e, rfl⟩ := hm
  obtain ⟨a', b', c', d', e', rfl⟩ := hn
  refine ⟨a + a', b + b', c + c', d + d', e + e', ?_⟩
  omega

/-- The value semigroup, as an additive submonoid of the natural numbers. -/
def valueSemigroup : AddSubmonoid ℕ where
  carrier := {n | Gamma n}
  zero_mem' := gamma_zero
  add_mem' := gamma_add

theorem gamma_ten : Gamma 10 := ⟨1, 0, 0, 0, 0, by omega⟩
theorem gamma_eleven : Gamma 11 := ⟨0, 1, 0, 0, 0, by omega⟩
theorem gamma_thirtyFour : Gamma 34 := ⟨0, 0, 1, 0, 0, by omega⟩
theorem gamma_fortySix : Gamma 46 := ⟨0, 0, 0, 1, 0, by omega⟩
theorem gamma_fiftyEight : Gamma 58 := ⟨0, 0, 0, 0, 1, by omega⟩

/-- The finite list below the conductor; membership remains defined by `Gamma`. -/
def valuesBelowConductor : Finset ℕ :=
  {0, 10, 11, 20, 21, 22, 30, 31, 32, 33, 34,
   40, 41, 42, 43, 44, 45, 46, 50, 51, 52, 53, 54, 55, 56, 57, 58}

theorem gamma_below_conductor {n : ℕ} (hn : n < 60) :
    Gamma n ↔ n ∈ valuesBelowConductor := by
  constructor
  · rintro ⟨a, b, c, d, e, heq⟩
    simp only [valuesBelowConductor, Finset.mem_insert, Finset.mem_singleton]
    have ha : a ≤ 5 := by omega
    have hb : b ≤ 5 := by omega
    have hc : c ≤ 1 := by omega
    have hd : d ≤ 1 := by omega
    have he : e ≤ 1 := by omega
    interval_cases a <;> interval_cases b <;> interval_cases c <;>
      interval_cases d <;> interval_cases e <;> omega
  · intro h
    simp only [valuesBelowConductor, Finset.mem_insert, Finset.mem_singleton] at h
    rcases h with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
      rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
      rfl | rfl | rfl | rfl | rfl <;> unfold Gamma
    · exact ⟨0, 0, 0, 0, 0, by omega⟩
    · exact ⟨1, 0, 0, 0, 0, by omega⟩
    · exact ⟨0, 1, 0, 0, 0, by omega⟩
    · exact ⟨2, 0, 0, 0, 0, by omega⟩
    · exact ⟨1, 1, 0, 0, 0, by omega⟩
    · exact ⟨0, 2, 0, 0, 0, by omega⟩
    · exact ⟨3, 0, 0, 0, 0, by omega⟩
    · exact ⟨2, 1, 0, 0, 0, by omega⟩
    · exact ⟨1, 2, 0, 0, 0, by omega⟩
    · exact ⟨0, 3, 0, 0, 0, by omega⟩
    · exact ⟨0, 0, 1, 0, 0, by omega⟩
    · exact ⟨4, 0, 0, 0, 0, by omega⟩
    · exact ⟨3, 1, 0, 0, 0, by omega⟩
    · exact ⟨2, 2, 0, 0, 0, by omega⟩
    · exact ⟨1, 3, 0, 0, 0, by omega⟩
    · exact ⟨1, 0, 1, 0, 0, by omega⟩
    · exact ⟨0, 1, 1, 0, 0, by omega⟩
    · exact ⟨0, 0, 0, 1, 0, by omega⟩
    · exact ⟨5, 0, 0, 0, 0, by omega⟩
    · exact ⟨4, 1, 0, 0, 0, by omega⟩
    · exact ⟨3, 2, 0, 0, 0, by omega⟩
    · exact ⟨2, 3, 0, 0, 0, by omega⟩
    · exact ⟨2, 0, 1, 0, 0, by omega⟩
    · exact ⟨1, 1, 1, 0, 0, by omega⟩
    · exact ⟨1, 0, 0, 1, 0, by omega⟩
    · exact ⟨0, 1, 0, 1, 0, by omega⟩
    · exact ⟨0, 0, 0, 0, 1, by omega⟩

/-- All integers from the conductor onward occur, with no finite-range cutoff. -/
theorem gamma_of_ge_sixty (n : ℕ) (hn : 60 ≤ n) : Gamma n := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases h : n < 70
    · interval_cases n
      · exact ⟨6, 0, 0, 0, 0, by omega⟩
      · exact ⟨5, 1, 0, 0, 0, by omega⟩
      · exact ⟨4, 2, 0, 0, 0, by omega⟩
      · exact ⟨3, 3, 0, 0, 0, by omega⟩
      · exact ⟨3, 0, 1, 0, 0, by omega⟩
      · exact ⟨2, 1, 1, 0, 0, by omega⟩
      · exact ⟨2, 0, 0, 1, 0, by omega⟩
      · exact ⟨1, 1, 0, 1, 0, by omega⟩
      · exact ⟨1, 0, 0, 0, 1, by omega⟩
      · exact ⟨0, 1, 0, 0, 1, by omega⟩
    · have hsmall : n - 10 < n := by omega
      have hlarge : 60 ≤ n - 10 := by omega
      have hh := gamma_add (ih (n - 10) hsmall hlarge) gamma_ten
      convert hh using 1; omega

theorem not_gamma_fiftyNine : ¬ Gamma 59 := by
  rw [gamma_below_conductor (by omega)]
  decide

/-- The conductor is exactly 60, rather than merely bounded above by 60. -/
theorem conductor_exact :
    (∀ n : ℕ, 60 ≤ n → Gamma n) ∧
    ∀ c : ℕ, (∀ n : ℕ, c ≤ n → Gamma n) → 60 ≤ c := by
  refine ⟨gamma_of_ge_sixty, ?_⟩
  intro c hc
  by_contra h
  exact not_gamma_fiftyNine (hc 59 (by omega))

/-- Every semigroup value at least 60 is a sum of two positive semigroup values. -/
theorem gamma_decomposable_of_ge_sixty (n : ℕ) (hn : 60 ≤ n) :
    ∃ a b : ℕ, Gamma a ∧ Gamma b ∧ 0 < a ∧ 0 < b ∧ n = a + b := by
  by_cases h : n < 70
  · interval_cases n
    · exact ⟨10, 50, (gamma_below_conductor (by omega)).mpr (by decide), (gamma_below_conductor (by omega)).mpr (by decide), by omega, by omega, by omega⟩
    · exact ⟨10, 51, (gamma_below_conductor (by omega)).mpr (by decide), (gamma_below_conductor (by omega)).mpr (by decide), by omega, by omega, by omega⟩
    · exact ⟨10, 52, (gamma_below_conductor (by omega)).mpr (by decide), (gamma_below_conductor (by omega)).mpr (by decide), by omega, by omega, by omega⟩
    · exact ⟨10, 53, (gamma_below_conductor (by omega)).mpr (by decide), (gamma_below_conductor (by omega)).mpr (by decide), by omega, by omega, by omega⟩
    · exact ⟨10, 54, (gamma_below_conductor (by omega)).mpr (by decide), (gamma_below_conductor (by omega)).mpr (by decide), by omega, by omega, by omega⟩
    · exact ⟨10, 55, (gamma_below_conductor (by omega)).mpr (by decide), (gamma_below_conductor (by omega)).mpr (by decide), by omega, by omega, by omega⟩
    · exact ⟨11, 55, (gamma_below_conductor (by omega)).mpr (by decide), (gamma_below_conductor (by omega)).mpr (by decide), by omega, by omega, by omega⟩
    · exact ⟨10, 57, (gamma_below_conductor (by omega)).mpr (by decide), (gamma_below_conductor (by omega)).mpr (by decide), by omega, by omega, by omega⟩
    · exact ⟨10, 58, (gamma_below_conductor (by omega)).mpr (by decide), (gamma_below_conductor (by omega)).mpr (by decide), by omega, by omega, by omega⟩
    · exact ⟨11, 58, (gamma_below_conductor (by omega)).mpr (by decide), (gamma_below_conductor (by omega)).mpr (by decide), by omega, by omega, by omega⟩
  · exact ⟨10, n - 10, gamma_ten, gamma_of_ge_sixty _ (by omega),
      by omega, by omega, by omega⟩

/-- The five listed values are precisely the nonzero indecomposable values. -/
theorem gamma_indecomposable_iff (n : ℕ) :
    (Gamma n ∧ n ≠ 0 ∧
      ∀ a b : ℕ, Gamma a → Gamma b → n = a + b → a = 0 ∨ b = 0) ↔
      n ∈ ({10, 11, 34, 46, 58} : Finset ℕ) := by
  constructor
  · rintro ⟨⟨a, b, c, d, e, hn⟩, hn0, h⟩
    simp only [Finset.mem_insert, Finset.mem_singleton]
    by_cases ha : a = 0
    · subst a
      by_cases hb : b = 0
      · subst b
        by_cases hc : c = 0
        · subst c
          by_cases hd : d = 0
          · subst d
            have he : 0 < e := by omega
            have hg : Gamma (58 * (e - 1)) := ⟨0, 0, 0, 0, e - 1, by omega⟩
            have hh := h 58 (58 * (e - 1)) gamma_fiftyEight hg (by omega)
            omega
          · have hg : Gamma (46 * (d - 1) + 58 * e) :=
              ⟨0, 0, 0, d - 1, e, by omega⟩
            have hh := h 46 _ gamma_fortySix hg (by omega)
            omega
        · have hg : Gamma (34 * (c - 1) + 46 * d + 58 * e) :=
            ⟨0, 0, c - 1, d, e, by omega⟩
          have hh := h 34 _ gamma_thirtyFour hg (by omega)
          omega
      · have hg : Gamma (11 * (b - 1) + 34 * c + 46 * d + 58 * e) :=
          ⟨0, b - 1, c, d, e, by omega⟩
        have hh := h 11 _ gamma_eleven hg (by omega)
        omega
    · have hg : Gamma (10 * (a - 1) + 11 * b + 34 * c + 46 * d + 58 * e) :=
        ⟨a - 1, b, c, d, e, by omega⟩
      have hh := h 10 _ gamma_ten hg (by omega)
      omega
  · intro hn
    have hn60 : n < 60 := by
      simp only [Finset.mem_insert, Finset.mem_singleton] at hn
      omega
    refine ⟨(gamma_below_conductor hn60).mpr ?_, ?_, ?_⟩
    · simp only [Finset.mem_insert, Finset.mem_singleton] at hn
      simp only [valuesBelowConductor, Finset.mem_insert, Finset.mem_singleton]
      omega
    · simp only [Finset.mem_insert, Finset.mem_singleton] at hn
      omega
    · intro a b ha hb hab
      have ha60 : a < 60 := by omega
      have hb60 : b < 60 := by omega
      rw [gamma_below_conductor ha60] at ha
      rw [gamma_below_conductor hb60] at hb
      simp only [valuesBelowConductor, Finset.mem_insert, Finset.mem_singleton] at ha hb
      simp only [Finset.mem_insert, Finset.mem_singleton] at hn
      omega

end EmbeddingDimensionStrata

