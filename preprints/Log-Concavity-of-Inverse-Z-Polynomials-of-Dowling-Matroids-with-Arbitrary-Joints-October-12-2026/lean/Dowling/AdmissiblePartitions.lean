import Dowling.BalancedComponents
import Dowling.GainCirclesGeometry
import Dowling.GainPartitionExt

noncomputable section
namespace Dowling
open scoped Classical
variable {G : Type*} [Group G] {n : ℕ}

/-- The zero block is generated by a retained joint, or by at least two vertices
and a nonidentity gain. This keeps the trivial-group boundary explicit. -/
def Admissible (X : Set (Fin n)) (p : GainPartition G n) : Prop :=
  ∀ i, p.code i = none →
    (∃ j ∈ X, p.code j = none) ∨
    (Nontrivial G ∧ ∃ j, j ≠ i ∧ p.code j = none)

/-- Every actual selected edge set satisfies precisely the necessary zero-block condition. -/
theorem admissible_of_solutions (X : Set (Fin n)) (S : Set (Edge G n))
    (hS : S ⊆ ground G n X) (p : GainPartition G n)
    (hp : p.solutionSet = solutions G n S) : Admissible X p := by
  intro i hi
  by_cases hjoint : ∃ j, Connected S i j ∧ Sum.inl j ∈ S
  · obtain ⟨j,hc,hj⟩ := hjoint
    left
    refine ⟨j,hS hj,?_⟩
    apply (p.solution_zero_iff j).mp
    intro x hx
    rw [hp] at hx
    exact hx (Sum.inl j) hj
  · have hnot : ¬ BalancedAt S i := fun hb =>
      (p.code_nonzero_iff_balanced S hp i).mpr hb hi
    have hloop : ∃ g, GainWalk S i i g ∧ g ≠ 1 := by
      by_contra hh
      apply hnot
      constructor
      · intro j hc hj
        exact hjoint ⟨j,hc,hj⟩
      · intro g hg
        by_contra hne
        exact hh ⟨g,hg,hne⟩
    obtain ⟨g,w,hg⟩ := hloop
    refine Or.inr ⟨⟨⟨g,1,hg⟩⟩,?_⟩
    cases w with
    | nil => exact False.elim (hg rfl)
    | @cons i j k a b ha hb =>
      refine ⟨j,ha.ne.symm,?_⟩
      apply (p.solution_zero_iff j).mp
      intro x hx
      have hxi := ((p.mem_solutionSet x).mp hx).1 i hi
      rw [hp] at hx
      rw [ha.equation hx, hxi, gainAct_none]

theorem admissible_univ (p : GainPartition G n) : Admissible Set.univ p :=
  fun i hi => Or.inl ⟨i,Set.mem_univ i,hi⟩

end Dowling
