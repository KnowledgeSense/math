import SphericalTreeFailures.CensusMoments

/-! # The filtration generated by the broadcast states

The preceding calculations used the larger input filtration. The tower property
now transfers the martingale and its exact conditional increment variance to the
sigma-field generated by the observable states through the preceding level.
-/
namespace SphericalTreeFailures
open MeasureTheory ProbabilityTheory Finset Filter
open scoped ENNReal ProbabilityTheory Topology

/-- The natural, state-generated filtration of the infinite broadcast. -/
def broadcastFiltration (i : Bool) : Filtration ℕ (inferInstance : MeasurableSpace BroadcastSpace) where
  seq h := ⨆ v : BinaryNode, ⨆ (_ : v.length ≤ h),
    MeasurableSpace.comap (fun ω : BroadcastSpace => broadcastState i ω v) inferInstance
  mono' := by
    intro h k hhk
    exact iSup_le fun v => iSup_le fun hv => le_iSup_of_le v (le_iSup_of_le (hv.trans hhk) le_rfl)
  le' := by
    intro h
    exact iSup_le fun v => iSup_le fun _ => (measurable_broadcastState i v).comap_le

theorem broadcastFiltration_le_input (i : Bool) (h : ℕ) :
    broadcastFiltration i h ≤ inputFiltration h :=
  iSup_le fun v => iSup_le fun hv => (measurable_broadcastState_at i h v hv).comap_le

theorem measurable_state_broadcastFiltration (i : Bool) (h : ℕ) (v : BinaryNode) (hv : v.length ≤ h) :
    @Measurable BroadcastSpace Bool (broadcastFiltration i h) inferInstance
      (fun ω => broadcastState i ω v) :=
  measurable_iff_comap_le.mpr (le_iSup_of_le v (le_iSup_of_le hv le_rfl))

theorem measurable_occupation_broadcastFiltration (i : Bool) (h : ℕ) (v : BinaryNode)
    (hv : v.length ≤ h) :
    @Measurable BroadcastSpace ℝ (broadcastFiltration i h) inferInstance (occupation i v) :=
  measurable_boolIndicator.comp (measurable_state_broadcastFiltration i h v hv)

theorem census_stronglyAdapted (p : ℝ) (i : Bool) :
    StronglyAdapted (broadcastFiltration i) (censusMartingale p i) := by
  intro h
  apply Measurable.stronglyMeasurable
  apply measurable_const.mul
  exact Finset.measurable_sum _ fun v hv =>
    (measurable_occupation_broadcastFiltration i h v ((mem_binaryLevel _ _).mp hv).le).sub measurable_const

/-- The census martingale with the filtration specified in the paper. -/
theorem census_is_natural_martingale (p : unitInterval) (hp : 0 < (p : ℝ)) (i : Bool) :
    Martingale (censusMartingale p i) (broadcastFiltration i) (broadcastMeasure p) := by
  apply martingale_nat (census_stronglyAdapted p i) (integrable_censusMartingale p i)
  intro h
  have ht := condExp_condExp_of_le (μ := broadcastMeasure p)
    (f := censusMartingale p i (h + 1)) (broadcastFiltration_le_input i h) (inputFiltration.le h)
  have he : (broadcastMeasure p)[(broadcastMeasure p)[censusMartingale p i (h + 1) |
      inputFiltration h] | broadcastFiltration i h] =ᵐ[broadcastMeasure p]
      (broadcastMeasure p)[censusMartingale p i h | broadcastFiltration i h] :=
    condExp_congr_ae ((census_is_martingale p hp i).condExp_ae_eq (Nat.le_succ h))
  rw [condExp_of_stronglyMeasurable ((broadcastFiltration i).le h)
    (census_stronglyAdapted p i h) (integrable_censusMartingale p i h)] at he
  exact (ht.symm.trans he).symm

theorem conditional_census_increment_variance_natural (p : unitInterval) (hp : 0 < (p : ℝ))
    (i : Bool) (h : ℕ) :
    (broadcastMeasure p)[(fun ω =>
      (censusMartingale p i (h + 1) ω - censusMartingale p i h ω) ^ 2) |
        broadcastFiltration i h] =ᵐ[broadcastMeasure p]
      fun ω => (censusScale p ^ (2 * (h + 1)))⁻¹ * (p : ℝ) * (1 - p) *
        ∑ v ∈ binaryLevel (h + 1), parentVacancy i v ω := by
  let f : BroadcastSpace → ℝ := fun ω =>
    (censusMartingale p i (h + 1) ω - censusMartingale p i h ω) ^ 2
  let g : BroadcastSpace → ℝ := fun ω =>
    (censusScale p ^ (2 * (h + 1)))⁻¹ * (p : ℝ) * (1 - p) *
      ∑ v ∈ binaryLevel (h + 1), parentVacancy i v ω
  have hg : StronglyMeasurable[broadcastFiltration i h] g := by
    apply Measurable.stronglyMeasurable
    apply measurable_const.mul
    apply Finset.measurable_sum
    intro v hv
    apply measurable_const.sub
    apply measurable_occupation_broadcastFiltration
    simp only [List.length_tail, (mem_binaryLevel _ _).mp hv, Nat.add_sub_cancel_right, le_refl]
  have hce := conditional_census_increment_variance p hp i h
  have hi : Integrable g (broadcastMeasure p) := integrable_condExp.congr hce
  have ht := condExp_condExp_of_le (μ := broadcastMeasure p) (f := f)
    (broadcastFiltration_le_input i h) (inputFiltration.le h)
  have he : (broadcastMeasure p)[(broadcastMeasure p)[f | inputFiltration h] |
      broadcastFiltration i h] =ᵐ[broadcastMeasure p]
      (broadcastMeasure p)[g | broadcastFiltration i h] := condExp_congr_ae hce
  rw [condExp_of_stronglyMeasurable ((broadcastFiltration i).le h) hg hi] at he
  exact ht.symm.trans he

theorem conditional_census_increment_bound_natural (p : unitInterval) (hp : 0 < (p : ℝ))
    (i : Bool) (h : ℕ) :
    (broadcastMeasure p)[(fun ω =>
      (censusMartingale p i (h + 1) ω - censusMartingale p i h ω) ^ 2) |
        broadcastFiltration i h] ≤ᵐ[broadcastMeasure p]
      fun _ => (p : ℝ) * (1 - p) * ((2 * (p : ℝ) ^ 2) ^ (h + 1))⁻¹ := by
  filter_upwards [conditional_census_increment_variance_natural p hp i h,
    conditional_census_increment_variance p hp i h, conditional_census_increment_bound p hp i h]
      with ω ha hb hc
  rwa [ha, hb] at *

end SphericalTreeFailures
