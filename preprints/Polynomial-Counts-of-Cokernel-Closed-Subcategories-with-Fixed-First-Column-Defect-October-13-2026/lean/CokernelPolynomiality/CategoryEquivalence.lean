import CokernelPolynomiality.CategoryClosureSufficiency
import CokernelPolynomiality.CategoryIntervalSignature
import CokernelPolynomiality.PointCounting

noncomputable section
open CategoryTheory CategoryTheory.Limits
open scoped ZeroObject
namespace CokernelPolynomiality

/-- The actual full additive subcategory generated by a closed triangular set. -/
def subcategoryOfClosed {n : ℕ} (Y : Finset (ℕ × ℕ)) (hY : IsClosed Y) : CokernelSubcategory n where
  contains := IntervalHull n Y
  iso_closed := fun e h => .iso e h
  zero_mem := .zero _ (isZero_zero _)
  biprod_mem := fun hV hW => .biprod _ _ hV hW
  retract_mem := fun i p hip hW => hW.retract_mem i p hip
  cokernel_mem := fun f hV hW => IntervalHull.cokernel_mem hY hV hW f

theorem subcategoryOfClosed_intervalSet {n : ℕ} (Y : Finset (ℕ × ℕ))
    (hbound : Y ⊆ triangle n) (hY : IsClosed Y) :
    (subcategoryOfClosed (n:=n) Y hY).intervalSet=Y := by
  classical
  ext p
  rcases p with ⟨a,b⟩
  rw [CokernelSubcategory.mem_intervalSet]
  constructor
  · rintro ⟨hab,hbn,hmem⟩
    exact (IntervalHull.interval_iff hab hbn).mp hmem
  · intro hmem
    obtain ⟨hab,hbn⟩ := mem_triangle.mp (hbound hmem)
    exact ⟨hab,hbn,(IntervalHull.interval_iff hab hbn).mpr hmem⟩

/-- Exact correspondence, including the original first-column statistic. -/
def categoricalClosedPointEquiv (n k : ℕ) :
    {C : CokernelSubcategory n // C.firstColumnCard=k} ≃ ClosedPoints n k where
  toFun C := ⟨C.val.intervalSet,C.val.intervalSet_subset,C.val.intervalSet_closed,
    C.val.firstColumnSize_intervalSet.trans C.property⟩
  invFun Y := ⟨subcategoryOfClosed Y.val Y.property.2.1,by
    rw [← CokernelSubcategory.firstColumnSize_intervalSet,
      subcategoryOfClosed_intervalSet Y.val Y.property.1 Y.property.2.1]
    exact Y.property.2.2⟩
  left_inv C := by
    apply Subtype.ext
    apply CokernelSubcategory.intervalSet_injective n
    exact subcategoryOfClosed_intervalSet C.val.intervalSet C.val.intervalSet_subset C.val.intervalSet_closed
  right_inv Y := Subtype.ext (subcategoryOfClosed_intervalSet Y.val Y.property.1 Y.property.2.1)

/-- The independent categorical count equals the finite count proved in the
combinatorial part of the formalization. -/
theorem categoryCount_eq_r (n k : ℕ) : categoryCount n k=r n k := by
  rw [r_eq_card_closedPoints]
  unfold categoryCount
  rw [← Nat.card_eq_fintype_card]
  exact Nat.card_congr (categoricalClosedPointEquiv n k)

end CokernelPolynomiality
