import TerminalLogConcavity.GraphPolynomial
import TerminalLogConcavity.Amplifier

namespace TerminalLogConcavity
open Polynomial
open scoped Polynomial

/-- The gap-one rooted blocks generated by the binary product. -/
inductive Block where
  | leaf
  | binary (left right : Block)

def Block.children : Block → ForestExpr
  | .leaf => .empty
  | .binary a b => .union (.root (.root a.children)) (.root (.root b.children))

abbrev Block.toForest (b : Block) : ForestExpr := .root b.children
abbrev Block.Vertex (b : Block) := b.toForest.Vertex
noncomputable def Block.graph (b : Block) : SimpleGraph b.Vertex := b.toForest.graph

noncomputable def Block.pair : Block → ℕ[X] × ℕ[X]
  | .leaf => (1 + X, 1)
  | .binary a b =>
    (a.pair.1 * b.pair.1 + X * (a.pair.1 + a.pair.2) * (b.pair.1 + b.pair.2),
     (a.pair.1 + a.pair.2) * (b.pair.1 + b.pair.2))
noncomputable def Block.A (b : Block) : ℕ[X] := b.pair.1
noncomputable def Block.B (b : Block) : ℕ[X] := b.pair.2

@[simp] theorem Block.A_leaf : Block.leaf.A = 1 + X := rfl
@[simp] theorem Block.B_leaf : Block.leaf.B = 1 := rfl
@[simp] theorem Block.A_binary (a b : Block) :
    (Block.binary a b).A = a.A * b.A + X * (a.A + a.B) * (b.A + b.B) := rfl
@[simp] theorem Block.B_binary (a b : Block) :
    (Block.binary a b).B = (a.A + a.B) * (b.A + b.B) := rfl

def Block.rank : Block → ℕ
  | .leaf => 1
  | .binary a b => a.rank + b.rank + 1

theorem Block.rank_pos (b : Block) : 0 < b.rank := by
  cases b <;> simp [rank]

@[simp] theorem Block.children_flag (b : Block) : flag b.children = false := by
  induction b with
  | leaf => rfl
  | binary a b ha hb => simp [children, flag, ha, hb]

@[simp] theorem Block.children_alpha (b : Block) : b.children.alpha + 1 = b.rank := by
  induction b with
  | leaf => rfl
  | binary a b ha hb => simp [children, ForestExpr.alpha, flag, children_flag, rank]; omega

@[simp] theorem Block.toForest_alpha (b : Block) : b.toForest.alpha = b.rank := by
  simp [ForestExpr.alpha]

theorem Block.graph_indepNum (b : Block) : b.graph.indepNum = b.rank := by
  exact b.toForest.graph_alpha.trans b.toForest_alpha

theorem Block.graph_isTree (b : Block) : b.graph.IsTree :=
  b.children.root_graph_isTree

@[simp] theorem Block.A_constant (b : Block) : b.A.coeff 0 = 1 := by
  induction b with
  | leaf => simp
  | binary a b ha hb => simp [mul_coeff_zero, ha, hb]

def Block.balanced : ℕ → Block
  | 0 => .leaf
  | t + 1 => .binary (balanced t) (balanced t)

@[simp] theorem Block.balanced_B_constant (t : ℕ) :
    (Block.balanced t).B.coeff 0 = amplifier t := by
  induction t with
  | zero => simp [balanced]
  | succ t ih => simp [balanced, mul_coeff_zero, ih, pow_two]

end TerminalLogConcavity
