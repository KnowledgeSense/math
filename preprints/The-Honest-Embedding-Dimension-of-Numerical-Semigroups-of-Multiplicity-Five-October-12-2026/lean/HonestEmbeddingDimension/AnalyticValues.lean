import HonestEmbeddingDimension.FormalValues
import Mathlib.Analysis.Analytic.Order

open Filter Asymptotics
open scoped Topology BigOperators

namespace HonestEmbeddingDimension

/-- Values of the genuine convergent analytic algebra generated by the coordinate germ. -/
def analyticValues {d : ℕ} (F : ℂ → Fin d → ℂ) : Set ℕ :=
  {n | ∃ G : (Fin d → ℂ) → ℂ, AnalyticAt ℂ G 0 ∧
    analyticOrderAt (fun t => G (F t)) 0 = n}

/-- Values of actual polynomial functions of an analytic coordinate germ. -/
def analyticPolynomialValues {d : ℕ} (F : ℂ → Fin d → ℂ) : Set ℕ :=
  {n | ∃ P : MvPolynomial (Fin d) ℂ,
    analyticOrderAt (fun t => MvPolynomial.eval (F t) P) 0 = n}

/-- The diagonal of a multilinear form, expanded in the coordinate basis. -/
noncomputable def diagonalPolynomial {d n : ℕ}
    (p : (Fin d → ℂ) [×n]→L[ℂ] ℂ) : MvPolynomial (Fin d) ℂ :=
  ∑ r : Fin n → Fin d,
    MvPolynomial.C (p (fun j => Pi.single (r j) 1)) * ∏ j, MvPolynomial.X (r j)

/-- A finite-dimensional multilinear diagonal is literally an ordinary multivariate polynomial. -/
theorem eval_diagonalPolynomial {d n : ℕ}
    (p : (Fin d → ℂ) [×n]→L[ℂ] ℂ) (x : Fin d → ℂ) :
    MvPolynomial.eval x (diagonalPolynomial p) = p (fun _ => x) := by
  classical
  rw [diagonalPolynomial, map_sum]
  simp only [map_mul, MvPolynomial.eval_C, map_prod, MvPolynomial.eval_X]
  rw [show (fun _ : Fin n => x) =
      (fun _ => ∑ i, x i • Pi.single i (1 : ℂ)) from
    funext (fun _ => pi_eq_sum_univ' x)]
  rw [p.map_sum]
  apply Finset.sum_congr rfl
  intro r _
  rw [p.map_smul_univ]
  simp only [smul_eq_mul, mul_comm]

/-- Evaluation of a polynomial in analytic functions is analytic. -/
theorem analyticAt_eval_polynomial {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {d : ℕ} {F : E → Fin d → ℂ} {z : E}
    (hF : ∀ i, AnalyticAt ℂ (fun t => F t i) z) (P : MvPolynomial (Fin d) ℂ) :
    AnalyticAt ℂ (fun t => MvPolynomial.eval (F t) P) z := by
  induction P using MvPolynomial.induction_on with
  | C c => simpa using (analyticAt_const (𝕜 := ℂ) (x := z) (v := c))
  | add p q hp hq => simpa using hp.fun_add hq
  | mul_X p i hp => simpa using hp.fun_mul (hF i)

/-- Larger powers of the norm decay at least as fast near the origin. -/
theorem norm_pow_isBigO_of_le {m n : ℕ} (hmn : m ≤ n) :
    (fun t : ℂ => ‖t‖ ^ n) =O[𝓝 0] (fun t => ‖t‖ ^ m) := by
  refine isBigO_iff.2 ⟨1, ?_⟩
  filter_upwards [Metric.ball_mem_nhds (0 : ℂ) (show (0 : ℝ) < 1 by norm_num)] with t ht
  have ht' : ‖t‖ ≤ 1 := (mem_ball_zero_iff.mp ht).le
  simpa using pow_le_pow_of_le_one (norm_nonneg t) ht' hmn

/-- The usual asymptotic remainder bound forces the corresponding analytic vanishing order. -/
theorem le_analyticOrderAt_of_isBigO {f : ℂ → ℂ} (hf : AnalyticAt ℂ f 0) {N : ℕ}
    (h : f =O[𝓝 0] (fun t => ‖t‖ ^ N)) : (N : ℕ∞) ≤ analyticOrderAt f 0 := by
  by_contra hN
  have hlt : analyticOrderAt f 0 < (N : ℕ∞) := lt_of_not_ge hN
  have hfin : analyticOrderAt f 0 ≠ ⊤ := ne_top_of_lt hlt
  let m := analyticOrderNatAt f 0
  have hm : analyticOrderAt f 0 = (m : ℕ∞) := (Nat.cast_analyticOrderNatAt hfin).symm
  have hmN : m + 1 ≤ N := by rw [hm] at hlt; exact Nat.succ_le_of_lt (by exact_mod_cast hlt)
  obtain ⟨g, hg, hg0, hfg⟩ := hf.analyticOrderAt_eq_natCast.mp hm
  have hgO : (fun t => (g t)⁻¹) =O[𝓝 0] (fun _ => (1 : ℝ)) :=
    (hg.continuousAt.inv₀ hg0).isBigO
  have hp : (fun t : ℂ => t ^ m) =O[𝓝 0] (fun t => ‖t‖ ^ N) := by
    have hh := h.mul hgO
    apply hh.congr'
    · filter_upwards [hfg, hg.continuousAt.eventually_ne hg0] with t ht hgt
      simp [ht, hgt]
    · filter_upwards [] with t
      simp
  have hp' : (fun t : ℂ => (ContinuousMultilinearMap.mkPiRing ℂ (Fin m) (1 : ℂ))
      (fun _ => t)) =O[𝓝 0] (fun t => ‖t‖ ^ (m + 1)) := by
    simpa using hp.trans (norm_pow_isBigO_of_le hmN)
  have hz := hp'.continuousMultilinearMap_apply_eq_zero 1
  simp at hz

/-- Convert a genuine analytic Taylor partial sum into an ordinary multivariate polynomial. -/
noncomputable def taylorPolynomial {d : ℕ}
    (p : FormalMultilinearSeries ℂ (Fin d → ℂ) ℂ) (N : ℕ) : MvPolynomial (Fin d) ℂ :=
  ∑ n ∈ Finset.range N, diagonalPolynomial (p n)

theorem eval_taylorPolynomial {d : ℕ}
    (p : FormalMultilinearSeries ℂ (Fin d → ℂ) ℂ) (N : ℕ) (x : Fin d → ℂ) :
    MvPolynomial.eval x (taylorPolynomial p N) = p.partialSum N x := by
  simp [taylorPolynomial, FormalMultilinearSeries.partialSum, eval_diagonalPolynomial]

/-- The Taylor polynomial of a specified convergent analytic expansion gives the expected
order of approximation after substitution of a vanishing analytic coordinate germ. -/
theorem analytic_substitution_taylor_error {d : ℕ} {F : ℂ → Fin d → ℂ}
    (hF : ∀ i, AnalyticAt ℂ (fun t => F t i) 0) (hF0 : F 0 = 0)
    {G : (Fin d → ℂ) → ℂ} {p : FormalMultilinearSeries ℂ (Fin d → ℂ) ℂ}
    (hp : HasFPowerSeriesAt G p 0) (N : ℕ) :
    (N : ℕ∞) ≤ analyticOrderAt
      (fun t => G (F t) - MvPolynomial.eval (F t) (taylorPolynomial p N)) 0 := by
  have hFa : AnalyticAt ℂ F 0 := AnalyticAt.pi hF
  have hGc : AnalyticAt ℂ (fun t => G (F t)) 0 := (hF0 ▸ hp.analyticAt).comp hFa
  apply le_analyticOrderAt_of_isBigO (hGc.fun_sub (analyticAt_eval_polynomial hF _))
  have hFc : Tendsto F (𝓝 0) (𝓝 0) := hF0 ▸ hFa.continuousAt
  have hR := (hp.isBigO_sub_partialSum_pow N).comp_tendsto hFc
  have hFo : F =O[𝓝 0] (fun t : ℂ => t) := by
    simpa [hF0] using hFa.differentiableAt.isBigO_sub
  simpa [eval_taylorPolynomial, Function.comp_def] using hR.trans (hFo.norm_norm.pow N)

/-- Every convergent composite has a polynomial expression with the same finite jet,
expressed intrinsically as an analytic order bound on the difference. -/
theorem analytic_substitution_jet_eq_polynomial {d : ℕ} {F : ℂ → Fin d → ℂ}
    (hF : ∀ i, AnalyticAt ℂ (fun t => F t i) 0) (hF0 : F 0 = 0)
    {G : (Fin d → ℂ) → ℂ} (hG : AnalyticAt ℂ G 0) (N : ℕ) :
    ∃ P : MvPolynomial (Fin d) ℂ,
      (N : ℕ∞) ≤ analyticOrderAt (fun t => G (F t) - MvPolynomial.eval (F t) P) 0 := by
  obtain ⟨p, hp⟩ := hG
  exact ⟨taylorPolynomial p N, analytic_substitution_taylor_error hF hF0 hp N⟩

/-- Higher-order analytic errors do not alter a finite analytic value. -/
theorem analyticOrderAt_eq_of_sub_order_gt {f g : ℂ → ℂ} {n : ℕ}
    (hf : analyticOrderAt f 0 = n)
    (hfg : (n : ℕ∞) < analyticOrderAt (f - g) 0) : analyticOrderAt g 0 = n := by
  have hneg : analyticOrderAt (g - f) 0 = analyticOrderAt (f - g) 0 := by
    rw [← neg_sub f g, analyticOrderAt_neg]
  have hh := analyticOrderAt_add_eq_left_of_lt (f := f) (g := g - f)
    (by rwa [hf, hneg])
  rw [hf] at hh
  convert hh using 1
  congr 1
  ext t
  simp only [Pi.add_apply, Pi.sub_apply]
  ring

/-- The actual convergent algebra and polynomial algebra have exactly the same finite values. -/
theorem analyticValues_eq_analyticPolynomialValues {d : ℕ} (F : ℂ → Fin d → ℂ)
    (hF : ∀ i, AnalyticAt ℂ (fun t => F t i) 0) (hF0 : F 0 = 0) :
    analyticValues F = analyticPolynomialValues F := by
  ext n
  constructor
  · rintro ⟨G, hG, hn⟩
    obtain ⟨P, hP⟩ := analytic_substitution_jet_eq_polynomial hF hF0 hG (n + 1)
    refine ⟨P, analyticOrderAt_eq_of_sub_order_gt hn ?_⟩
    exact lt_of_lt_of_le (by exact_mod_cast Nat.lt_succ_self n) hP
  · rintro ⟨P, hn⟩
    refine ⟨fun x => MvPolynomial.eval x P, ?_, hn⟩
    apply analyticAt_eval_polynomial (F := fun x : Fin d → ℂ => x)
    intro i
    exact (ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : Fin d => ℂ) i).analyticAt 0

end HonestEmbeddingDimension
