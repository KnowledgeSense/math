import HonestEmbeddingDimension.CollisionArithmetic
import HonestEmbeddingDimension.PlaneValues

namespace HonestEmbeddingDimension

/-- The actual additive monoid generated by `m,a`. -/
def generatedPair (m a : ℕ) : AddSubmonoid ℕ where
  carrier := {n | ∃ x p, n = m * x + a * p}
  zero_mem' := ⟨0, 0, by simp⟩
  add_mem' := by
    rintro n n' ⟨x, p, rfl⟩ ⟨x', p', rfl⟩
    exact ⟨x + x', p + p', by ring⟩

/-- The actual additive monoid generated by `5,a,b`. -/
def generatedTriple (a b : ℕ) : AddSubmonoid ℕ where
  carrier := {n | ∃ x p q, n = 5 * x + a * p + b * q}
  zero_mem' := ⟨0, 0, 0, by simp⟩
  add_mem' := by
    rintro n n' ⟨x, p, q, rfl⟩ ⟨x', p', q', rfl⟩
    exact ⟨x + x', p + p', q + q', by ring⟩

@[simp] theorem mem_generatedPair (m a n : ℕ) :
    n ∈ generatedPair m a ↔ ∃ x p, n = m * x + a * p := Iff.rfl

@[simp] theorem mem_generatedTriple (a b n : ℕ) :
    n ∈ generatedTriple a b ↔ ∃ x p q, n = 5 * x + a * p + b * q := Iff.rfl

/-- Coprimality establishes cofiniteness of the actual three-generator monoid. -/
def tripleSemigroup (a b : ℕ) (hcop : Nat.Coprime 5 a) : NumericalSemigroup where
  monoid := generatedTriple a b
  finite_complement := by
    apply (Set.finite_Iio (4 * a)).subset
    intro n hn
    change n < 4 * a
    by_contra h
    obtain ⟨x, p, _, hp⟩ := two_generator_representation 5 a n (by omega) hcop (by omega)
    exact hn ⟨x, p, 0, by simpa using hp⟩

/-- Coprimality establishes cofiniteness of the actual two-generator monoid. -/
def pairSemigroup (m a : ℕ) (hm : 0 < m) (hcop : Nat.Coprime m a) : NumericalSemigroup where
  monoid := generatedPair m a
  finite_complement := by
    apply (Set.finite_Iio ((m - 1) * a)).subset
    intro n hn
    change n < (m - 1) * a
    by_contra h
    obtain ⟨x, p, _, hp⟩ := two_generator_representation m a n hm hcop (by omega)
    exact hn ⟨x, p, hp⟩

/-- Indexing the five residue classes by the coefficient of a coprime generator. -/
def residueIndexFive (n : ℕ) : Fin 5 := ⟨n % 5, Nat.mod_lt n (by omega)⟩

@[simp] theorem residueIndexFive_val (r : Fin 5) : residueIndexFive r.val = r := by
  ext
  exact Nat.mod_eq_of_lt r.isLt

@[simp] theorem residueIndexFive_mod (n : ℕ) : residueIndexFive (n % 5) = residueIndexFive n := by
  ext
  exact Nat.mod_mod _ _

/-- The finite transition criterion for a genuine Apéry table, in the rotated residues. -/
theorem triple_apery_table {a b k : ℕ} (hcop : Nat.Coprime 5 a)
    (hb : b % 5 = (k * a) % 5) (u : Fin 5 → ℕ)
    (hzero : u 0 = 0)
    (hmem : ∀ r, u r ∈ generatedTriple a b)
    (hmod : ∀ r, u r % 5 = (a * r.val) % 5)
    (hstepA : ∀ r, u (residueIndexFive (r.val + 1)) ≤ u r + a)
    (hstepB : ∀ r, u (residueIndexFive (r.val + k)) ≤ u r + b) :
    ∀ r : Fin 5, (tripleSemigroup a b hcop).aperyMin 5 (by omega) (a * r.val) = u r := by
  have hbound : ∀ p q, u (residueIndexFive (p + k * q)) ≤ a * p + b * q := by
    intro p q
    induction q with
    | zero =>
      simp only [Nat.mul_zero, Nat.add_zero]
      induction p with
      | zero => simpa [residueIndexFive] using (le_of_eq hzero)
      | succ p ih =>
        have hh := hstepA (residueIndexFive p)
        have heq : residueIndexFive ((residueIndexFive p).val + 1) = residueIndexFive (p + 1) := by
          ext
          simp [residueIndexFive, Nat.add_mod]
        rw [heq] at hh
        calc u (residueIndexFive (p + 1)) ≤ u (residueIndexFive p) + a := hh
          _ ≤ a * p + a := Nat.add_le_add_right ih a
          _ = a * (p + 1) := by ring
    | succ q ih =>
      have hh := hstepB (residueIndexFive (p + k * q))
      have heq : residueIndexFive ((residueIndexFive (p + k * q)).val + k) =
          residueIndexFive (p + k * (q + 1)) := by
        ext
        change ((p + k * q) % 5 + k) % 5 = (p + k * (q + 1)) % 5
        have hh : p + k * (q + 1) = p + k * q + k := by ring
        rw [hh, Nat.mod_add_mod]
      rw [heq] at hh
      calc u (residueIndexFive (p + k * (q + 1))) ≤ u (residueIndexFive (p + k * q)) + b := hh
        _ ≤ (a * p + b * q) + b := Nat.add_le_add_right ih b
        _ = a * p + b * (q + 1) := by ring
  intro r
  apply le_antisymm
  · exact NumericalSemigroup.aperyMin_le (hmem r) (hmod r)
  · obtain ⟨x, p, q, heq⟩ := (tripleSemigroup a b hcop).aperyMin_mem 5 (by omega) (a * r.val)
    have hmodn := (tripleSemigroup a b hcop).aperyMin_mod 5 (by omega) (a * r.val)
    rw [heq] at hmodn
    have hr : (p + k * q) % 5 = r.val % 5 := by
      have hh : (a * p + b * q) % 5 = (a * r.val + b * 0) % 5 := by
        simpa [Nat.add_mod] using hmodn
      simpa using five_weighted_residue_cancel hcop hb hh
    have hidx : residueIndexFive (p + k * q) = r := by
      ext
      exact hr.trans (Nat.mod_eq_of_lt r.isLt)
    have hh := hbound p q
    rw [hidx] at hh
    omega

/-- Lemma 3.1, all five Apéry entries for the residue-multiplier-two case. -/
theorem triple_apery_table_two {a b : ℕ} (hab : a < b) (hba : b < 2 * a)
    (hcop : Nat.Coprime 5 a) (hb : b % 5 = (2 * a) % 5) :
    ∀ r : Fin 5, (tripleSemigroup a b hcop).aperyMin 5 (by omega) (a * r.val) =
      ![0, a, b, a + b, 2 * b] r := by
  apply triple_apery_table hcop hb
  · rfl
  · intro r
    fin_cases r
    · exact ⟨0, 0, 0, by simp⟩
    · exact ⟨0, 1, 0, by simp⟩
    · exact ⟨0, 0, 1, by simp⟩
    · exact ⟨0, 1, 1, by simp⟩
    · exact ⟨0, 0, 2, by simp [Nat.mul_comm]⟩
  · intro r
    fin_cases r <;> dsimp <;> omega
  · intro r
    fin_cases r <;> norm_num [residueIndexFive] <;> omega
  · intro r
    fin_cases r <;> norm_num [residueIndexFive] <;> omega

/-- Lemma 3.1, all five Apéry entries for the residue-multiplier-three case. -/
theorem triple_apery_table_three {a b : ℕ} (hab : a < b) (hba : b < 3 * a)
    (hcop : Nat.Coprime 5 a) (hb : b % 5 = (3 * a) % 5) :
    ∀ r : Fin 5, (tripleSemigroup a b hcop).aperyMin 5 (by omega) (a * r.val) =
      ![0, a, 2 * a, b, a + b] r := by
  apply triple_apery_table hcop hb
  · rfl
  · intro r
    fin_cases r
    · exact ⟨0, 0, 0, by simp⟩
    · exact ⟨0, 1, 0, by simp⟩
    · exact ⟨0, 2, 0, by simp [Nat.mul_comm]⟩
    · exact ⟨0, 0, 1, by simp⟩
    · exact ⟨0, 1, 1, by simp⟩
  · intro r
    fin_cases r <;> dsimp <;> omega
  · intro r
    fin_cases r <;> norm_num [residueIndexFive] <;> omega
  · intro r
    fin_cases r <;> norm_num [residueIndexFive] <;> omega

/-- Lemma 3.1, all five Apéry entries for the residue-multiplier-four case. -/
theorem triple_apery_table_four {a b : ℕ} (hab : a < b) (hba : b < 4 * a)
    (hcop : Nat.Coprime 5 a) (hb : b % 5 = (4 * a) % 5) :
    ∀ r : Fin 5, (tripleSemigroup a b hcop).aperyMin 5 (by omega) (a * r.val) =
      ![0, a, 2 * a, min (3 * a) (2 * b), b] r := by
  apply triple_apery_table hcop hb
  · rfl
  · intro r
    fin_cases r
    · exact ⟨0, 0, 0, by simp⟩
    · exact ⟨0, 1, 0, by simp⟩
    · exact ⟨0, 2, 0, by simp [Nat.mul_comm]⟩
    · rcases le_total (3 * a) (2 * b) with hh | hh
      · refine ⟨0, 3, 0, ?_⟩
        change min (3 * a) (2 * b) = 5 * 0 + a * 3 + b * 0
        rw [min_eq_left hh]
        ring
      · refine ⟨0, 0, 2, ?_⟩
        change min (3 * a) (2 * b) = 5 * 0 + a * 0 + b * 2
        rw [min_eq_right hh]
        ring
    · exact ⟨0, 0, 1, by simp⟩
  · intro r
    fin_cases r <;> dsimp <;> omega
  · intro r
    fin_cases r <;> norm_num [residueIndexFive] <;> omega
  · intro r
    fin_cases r <;> norm_num [residueIndexFive] <;> omega

end HonestEmbeddingDimension
