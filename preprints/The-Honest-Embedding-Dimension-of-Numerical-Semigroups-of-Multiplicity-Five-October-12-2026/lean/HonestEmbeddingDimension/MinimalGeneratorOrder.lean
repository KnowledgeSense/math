import HonestEmbeddingDimension.AperyTables

namespace HonestEmbeddingDimension
namespace NumericalSemigroup

/-- Every intrinsic minimal generator occurs in every generating set. -/
theorem minimalGenerator_mem_of_mem_closure {S : NumericalSemigroup} {G : Set ℕ}
    (hG : G ⊆ S.monoid) {n : ℕ} (hn : S.IsMinimalGenerator n)
    (hclosure : n ∈ AddSubmonoid.closure G) : n ∈ G := by
  have hle : AddSubmonoid.closure G ≤ S.monoid := AddSubmonoid.closure_le.mpr hG
  induction hclosure using AddSubmonoid.closure_induction with
  | mem x hx => exact hx
  | zero => exact False.elim (Nat.lt_irrefl 0 hn.1)
  | add x y hx hy ihx ihy =>
    rcases hn.2.2 x (hle hx) y (hle hy) rfl with hx0 | hy0
    · subst x
      simpa using ihy (by simpa using hn)
    · subst y
      simpa using ihx (by simpa using hn)

/-- The number of generators is the finite cardinality of the intrinsic minimal set. -/
noncomputable def embeddingDimension (S : NumericalSemigroup) : ℕ := S.minimalGenerators.ncard

/-- A sorted enumeration of precisely the actual minimal generators. -/
structure OrderedMinimalGenerators (S : NumericalSemigroup) (e : ℕ) where
  generators : Fin e → ℕ
  strictMono : StrictMono generators
  range_eq : Set.range generators = S.minimalGenerators

namespace OrderedMinimalGenerators

theorem isMinimal {S : NumericalSemigroup} {e : ℕ} (G : S.OrderedMinimalGenerators e)
    (i : Fin e) : S.IsMinimalGenerator (G.generators i) := by
  change G.generators i ∈ S.minimalGenerators
  rw [← G.range_eq]
  exact ⟨i, rfl⟩

theorem generates {S : NumericalSemigroup} {e : ℕ} (G : S.OrderedMinimalGenerators e) :
    AddSubmonoid.closure (Set.range G.generators) = S.monoid := by
  rw [G.range_eq, S.closure_minimalGenerators]

theorem embeddingDimension_eq {S : NumericalSemigroup} {e : ℕ}
    (G : S.OrderedMinimalGenerators e) : S.embeddingDimension = e := by
  rw [embeddingDimension, ← G.range_eq]
  simpa using Set.ncard_range_of_injective G.strictMono.injective

theorem first_eq_multiplicity {S : NumericalSemigroup} {e m : ℕ}
    (G : S.OrderedMinimalGenerators (e + 1)) (hm : HasMultiplicity S m) :
    G.generators 0 = m := by
  have hmgen := minimalGenerator_of_multiplicity hm
  obtain ⟨i, hi⟩ : m ∈ Set.range G.generators := by rw [G.range_eq]; exact hmgen
  apply le_antisymm
  · rw [← hi]
    exact G.strictMono.monotone (Fin.zero_le i)
  · exact hm.2.2 _ (G.isMinimal 0).2.1 (G.isMinimal 0).1

/-- The generator at index `i` is outside the monoid generated by earlier generators. -/
theorem not_mem_earlier {S : NumericalSemigroup} {e : ℕ}
    (G : S.OrderedMinimalGenerators e) (i : Fin e) :
    G.generators i ∉ AddSubmonoid.closure (G.generators '' {j | j < i}) := by
  intro hh
  have hsub : G.generators '' {j | j < i} ⊆ S.monoid := by
    rintro _ ⟨j, _, rfl⟩
    exact (G.isMinimal j).2.1
  obtain ⟨j, hj, heq⟩ := minimalGenerator_mem_of_mem_closure hsub (G.isMinimal i) hh
  have := G.strictMono hj
  omega

/-- Every smaller semigroup element is generated by earlier minimal generators. -/
theorem smaller_mem_earlier {S : NumericalSemigroup} {e : ℕ}
    (G : S.OrderedMinimalGenerators e) (i : Fin e) {n : ℕ}
    (hn : n ∈ S.monoid) (hnlt : n < G.generators i) :
    n ∈ AddSubmonoid.closure (G.generators '' {j | j < i}) := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases hn0 : n = 0
    · subst n
      exact AddSubmonoid.zero_mem _
    by_cases hmin : S.IsMinimalGenerator n
    · have hnrange : n ∈ Set.range G.generators := by rw [G.range_eq]; exact hmin
      obtain ⟨j, rfl⟩ := hnrange
      apply AddSubmonoid.subset_closure
      refine ⟨j, ?_, rfl⟩
      exact G.strictMono.lt_iff_lt.mp hnlt
    · have hdec : ∃ x ∈ S.monoid, ∃ y ∈ S.monoid, x + y = n ∧ x ≠ 0 ∧ y ≠ 0 := by
        simpa only [IsMinimalGenerator, show 0 < n from by omega, hn, true_and,
          not_forall, not_or, exists_prop] using hmin
      obtain ⟨x, hx, y, hy, hxy, hx0, hy0⟩ := hdec
      rw [← hxy]
      exact AddSubmonoid.add_mem _ (ih x (by omega) hx (by omega))
        (ih y (by omega) hy (by omega))

/-- Source equation (2.1): each sorted generator is the actual next outside element. -/
theorem least_outside_earlier {S : NumericalSemigroup} {e : ℕ}
    (G : S.OrderedMinimalGenerators e) (i : Fin e) {n : ℕ}
    (hn : n ∈ S.monoid)
    (hnot : n ∉ AddSubmonoid.closure (G.generators '' {j | j < i})) :
    G.generators i ≤ n := by
  by_contra hh
  exact hnot (G.smaller_mem_earlier i hn (by omega))

end OrderedMinimalGenerators
end NumericalSemigroup

/-- The elementary pair presentation agrees with additive closure. -/
theorem generatedPair_eq_closure (m a : ℕ) :
    generatedPair m a = AddSubmonoid.closure ({m, a} : Set ℕ) := by
  apply le_antisymm
  · rintro n ⟨x, p, rfl⟩
    apply AddSubmonoid.add_mem
    · have hm : m ∈ AddSubmonoid.closure ({m, a} : Set ℕ) :=
        AddSubmonoid.subset_closure (by simp)
      simpa [smul_eq_mul, Nat.mul_comm] using
        (AddSubmonoid.closure ({m, a} : Set ℕ)).nsmul_mem hm x
    · have ha : a ∈ AddSubmonoid.closure ({m, a} : Set ℕ) :=
        AddSubmonoid.subset_closure (by simp)
      simpa [smul_eq_mul, Nat.mul_comm] using
        (AddSubmonoid.closure ({m, a} : Set ℕ)).nsmul_mem ha p
  · apply AddSubmonoid.closure_le.mpr
    intro n hn
    rcases Set.mem_insert_iff.mp hn with rfl | hn
    swap
    · have hn : n = a := Set.mem_singleton_iff.mp hn
      subst n
      exact ⟨0, 1, by simp⟩
    · exact ⟨1, 0, by simp⟩

namespace NumericalSemigroup

theorem minimalGenerator_not_mem_generatedPair {S : NumericalSemigroup} {m a n : ℕ}
    (hm : m ∈ S.monoid) (ha : a ∈ S.monoid) (hn : S.IsMinimalGenerator n)
    (hnm : n ≠ m) (hna : n ≠ a) : n ∉ generatedPair m a := by
  rw [generatedPair_eq_closure]
  intro hh
  have hsub : ({m, a} : Set ℕ) ⊆ S.monoid := by
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl <;> assumption
  have hh := minimalGenerator_mem_of_mem_closure hsub hn hh
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hh
  tauto

end NumericalSemigroup

/-- Multiplication by a coprime residue enumerates all five residue classes. -/
theorem exists_residue_multiplier_five {a n : ℕ} (ha : Nat.Coprime 5 a) :
    ∃ k : Fin 5, n % 5 = (a * k.val) % 5 := by
  let f : Fin 5 → Fin 5 := fun k => residueIndexFive (a * k.val)
  have hf : Function.Injective f := by
    intro i j hij
    have hh := Nat.ModEq.cancel_left_of_coprime ha (congrArg Fin.val hij)
    apply Fin.ext
    simpa only [Nat.ModEq, Nat.mod_eq_of_lt i.isLt, Nat.mod_eq_of_lt j.isLt] using hh
  obtain ⟨k, hk⟩ := Finite.surjective_of_injective hf (residueIndexFive n)
  exact ⟨k, (congrArg Fin.val hk).symm⟩

/-- The possible residue multiplier of a new generator is exactly two, three, or four,
    and the new generator lies strictly below the corresponding multiple of `a`. -/
theorem new_generator_residue_multiplier {a b : ℕ} (ha : Nat.Coprime 5 a)
    (hab : a < b) (hnew : b ∉ generatedPair 5 a) :
    ∃ k, (k = 2 ∨ k = 3 ∨ k = 4) ∧ b % 5 = (k * a) % 5 ∧ b < k * a := by
  obtain ⟨k, hk⟩ := exists_residue_multiplier_five (n := b) ha
  have hmS : 5 ∈ (pairSemigroup 5 a (by omega) ha).monoid := ⟨1, 0, by simp⟩
  have hka : a * k.val ∈ (pairSemigroup 5 a (by omega) ha).monoid :=
    ⟨0, k.val, by simp⟩
  have hbound : b < a * k.val := by
    by_contra hh
    exact hnew (NumericalSemigroup.mem_of_same_residue_le hmS hka (by omega) hk.symm)
  have hk2 : 2 ≤ k.val := by
    by_contra hh
    have : k.val = 0 ∨ k.val = 1 := by omega
    rcases this with hh | hh
    · simp [hh] at hbound
    · simp [hh] at hbound
      omega
  refine ⟨k.val, ?_, ?_, ?_⟩
  · have := k.isLt
    omega
  · simpa [Nat.mul_comm] using hk
  · simpa [Nat.mul_comm] using hbound

/-- The finite transition criterion for an arbitrary genuinely generated numerical semigroup. -/
theorem apery_table_of_generator_transitions (S : NumericalSemigroup) {G : Set ℕ}
    (hgen : AddSubmonoid.closure G = S.monoid) {a : ℕ} (ha : Nat.Coprime 5 a)
    (u : Fin 5 → ℕ) (hzero : u 0 = 0) (hmem : ∀ r, u r ∈ S.monoid)
    (hmod : ∀ r, u r % 5 = (a * r.val) % 5)
    (hstep : ∀ g ∈ G, ∀ r : Fin 5, ∃ s : Fin 5,
      (a * s.val) % 5 = (a * r.val + g) % 5 ∧ u s ≤ u r + g) :
    ∀ r : Fin 5, S.aperyMin 5 (by omega) (a * r.val) = u r := by
  have hbound : ∀ n ∈ S.monoid, ∀ r : Fin 5, ∃ s : Fin 5,
      (a * s.val) % 5 = (a * r.val + n) % 5 ∧ u s ≤ u r + n := by
    intro n hn
    rw [← hgen] at hn
    induction hn using AddSubmonoid.closure_induction with
    | mem n hn => exact hstep n hn
    | zero => intro r; exact ⟨r, by simp, by simp⟩
    | add x y _ _ ihx ihy =>
      intro r
      obtain ⟨s, hsmod, hsle⟩ := ihx r
      obtain ⟨t, htmod, htle⟩ := ihy s
      refine ⟨t, ?_, by omega⟩
      rw [htmod, Nat.add_mod, hsmod, ← Nat.add_mod]
      congr 1
      omega
  intro r
  apply le_antisymm
  · exact NumericalSemigroup.aperyMin_le (hmem r) (hmod r)
  · obtain ⟨s, hsmod, hsle⟩ := hbound _ (S.aperyMin_mem 5 (by omega) (a * r.val)) 0
    simp only [Fin.val_zero, Nat.mul_zero, Nat.zero_add] at hsmod
    rw [S.aperyMin_mod] at hsmod
    have hsr : s = r := by
      apply Fin.ext
      have hh := Nat.ModEq.cancel_left_of_coprime ha hsmod
      simpa only [Nat.ModEq, Nat.mod_eq_of_lt s.isLt, Nat.mod_eq_of_lt r.isLt] using hh
    simpa [hsr, hzero] using hsle

/-- The elementary triple presentation agrees with additive closure. -/
theorem generatedTriple_eq_closure (a b : ℕ) :
    generatedTriple a b = AddSubmonoid.closure ({5, a, b} : Set ℕ) := by
  let T := AddSubmonoid.closure ({5, a, b} : Set ℕ)
  have h5 : 5 ∈ T := AddSubmonoid.subset_closure (by simp)
  have ha : a ∈ T := AddSubmonoid.subset_closure (by simp)
  have hb : b ∈ T := AddSubmonoid.subset_closure (by simp)
  apply le_antisymm
  · rintro n ⟨x, p, q, rfl⟩
    have hx : 5 * x ∈ T := by simpa [smul_eq_mul, Nat.mul_comm] using T.nsmul_mem h5 x
    have hp : a * p ∈ T := by simpa [smul_eq_mul, Nat.mul_comm] using T.nsmul_mem ha p
    have hq : b * q ∈ T := by simpa [smul_eq_mul, Nat.mul_comm] using T.nsmul_mem hb q
    exact T.add_mem (T.add_mem hx hp) hq
  · apply AddSubmonoid.closure_le.mpr
    intro n hn
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hn
    rcases hn with rfl | rfl | rfl
    · exact ⟨1, 0, 0, by simp⟩
    · exact ⟨0, 1, 0, by simp⟩
    · exact ⟨0, 0, 1, by simp⟩

namespace NumericalSemigroup

theorem minimalGenerator_not_mem_generatedTriple {S : NumericalSemigroup} {a b n : ℕ}
    (h5 : 5 ∈ S.monoid) (ha : a ∈ S.monoid) (hb : b ∈ S.monoid)
    (hn : S.IsMinimalGenerator n) (hn5 : n ≠ 5) (hna : n ≠ a) (hnb : n ≠ b) :
    n ∉ generatedTriple a b := by
  rw [generatedTriple_eq_closure]
  intro hh
  have hsub : ({5, a, b} : Set ℕ) ⊆ S.monoid := by
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl <;> assumption
  have hh := minimalGenerator_mem_of_mem_closure hsub hn hh
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hh
  tauto

/-- Minimal generators lie strictly below every decomposable member in their residue. -/
theorem minimalGenerator_lt_sum_of_same_residue {S : NumericalSemigroup} {m n x y : ℕ}
    (hm : 0 < m) (hmS : m ∈ S.monoid) (hn : S.IsMinimalGenerator n) (hnm : n ≠ m)
    (hx : x ∈ S.monoid) (hy : y ∈ S.monoid) (hx0 : 0 < x) (hy0 : 0 < y)
    (hr : n % m = (x + y) % m) : n < x + y := by
  have hap := minimalGenerator_mem_apery hm hmS hn hnm
  have heq := (mem_apery_iff_eq_aperyMin hm hmS).mp hap
  have hle : n ≤ x + y := by
    rw [heq]
    exact aperyMin_le (S.monoid.add_mem hx hy) hr.symm
  have hne : x + y ≠ n := by
    intro hh
    have := hn.2.2 x hx y hy hh
    omega
  omega

theorem minimalGenerator_lt_multiple_of_same_residue {S : NumericalSemigroup} {m n a k : ℕ}
    (hm : 0 < m) (hmS : m ∈ S.monoid) (hn : S.IsMinimalGenerator n) (hnm : n ≠ m)
    (ha : a ∈ S.monoid) (ha0 : 0 < a) (hk : 2 ≤ k)
    (hr : n % m = (k * a) % m) : n < k * a := by
  have hka : a * (k - 1) ∈ S.monoid := mul_mem ha _
  have hka0 : 0 < a * (k - 1) := Nat.mul_pos ha0 (by omega)
  have heq : a + a * (k - 1) = k * a := by
    have hh : k - 1 + 1 = k := by omega
    calc a + a * (k - 1) = a * (k - 1 + 1) := by ring
      _ = k * a := by rw [hh, Nat.mul_comm]
  rw [← heq]
  apply minimalGenerator_lt_sum_of_same_residue hm hmS hn hnm ha hka ha0 hka0
  rwa [heq]

theorem aperyMin_eq_minimalGenerator {S : NumericalSemigroup} {m n r : ℕ}
    (hm : 0 < m) (hmS : m ∈ S.monoid) (hn : S.IsMinimalGenerator n) (hne : n ≠ m)
    (hr : n % m = r % m) : S.aperyMin m hm r = n := by
  have hh := (mem_apery_iff_eq_aperyMin hm hmS).mp (minimalGenerator_mem_apery hm hmS hn hne)
  rw [aperyMin_eq_of_mod_eq hr] at hh
  exact hh.symm

/-- Membership below a bound is determined by the minimal generators below that bound. -/
theorem mem_of_minimalGenerators_mem_below {S : NumericalSemigroup} {T : AddSubmonoid ℕ}
    {N n : ℕ} (hgen : ∀ g, S.IsMinimalGenerator g → g < N → g ∈ T)
    (hn : n ∈ S.monoid) (hnlt : n < N) : n ∈ T := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases hn0 : n = 0
    · subst n
      exact T.zero_mem
    by_cases hmin : S.IsMinimalGenerator n
    · exact hgen n hmin hnlt
    · have hdec : ∃ x ∈ S.monoid, ∃ y ∈ S.monoid, x + y = n ∧ x ≠ 0 ∧ y ≠ 0 := by
        simpa only [IsMinimalGenerator, show 0 < n from by omega, hn, true_and,
          not_forall, not_or, exists_prop] using hmin
      obtain ⟨x, hx, y, hy, hxy, hx0, hy0⟩ := hdec
      rw [← hxy]
      exact T.add_mem (ih x (by omega) hx (by omega)) (ih y (by omega) hy (by omega))

theorem least_outside_of_minimalGenerators_below {S : NumericalSemigroup}
    {T : AddSubmonoid ℕ} {N n : ℕ}
    (hgen : ∀ g, S.IsMinimalGenerator g → g < N → g ∈ T)
    (hn : n ∈ S.monoid) (hnT : n ∉ T) : N ≤ n := by
  by_contra hh
  exact hnT (mem_of_minimalGenerators_mem_below hgen hn (by omega))

end NumericalSemigroup

end HonestEmbeddingDimension
