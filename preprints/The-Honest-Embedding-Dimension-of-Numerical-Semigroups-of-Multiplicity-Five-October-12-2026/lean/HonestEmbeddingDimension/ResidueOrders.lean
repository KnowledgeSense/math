import HonestEmbeddingDimension.FiniteReduction
import Mathlib.RingTheory.PowerSeries.Expand

namespace HonestEmbeddingDimension

/-- A finite sum with distinct finite orders cannot have a new leading order. -/
theorem order_sum_mem_of_pairwise {ι : Type*} (s : Finset ι) (f : ι → PowerSeries ℂ)
    (h : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → f i ≠ 0 → f j ≠ 0 →
      (f i).order ≠ (f j).order)
    (hne : ∑ i ∈ s, f i ≠ 0) :
    ∃ i ∈ s, f i ≠ 0 ∧ (∑ j ∈ s, f j).order = (f i).order := by
  classical
  induction s using Finset.induction_on with
  | empty => simp at hne
  | @insert a s ha ih =>
    rw [Finset.sum_insert ha] at hne ⊢
    by_cases hf : f a = 0
    · obtain ⟨i, hi, hfi, he⟩ := ih (by
        intro i hi j hj hij hfi hfj
        exact h i (Finset.mem_insert_of_mem hi) j (Finset.mem_insert_of_mem hj) hij hfi hfj)
        (by simpa [hf] using hne)
      exact ⟨i, Finset.mem_insert_of_mem hi, hfi, by simpa [hf] using he⟩
    by_cases hs : ∑ i ∈ s, f i = 0
    · exact ⟨a, Finset.mem_insert_self a s, hf, by simp [hs]⟩
    obtain ⟨i, hi, hfi, he⟩ := ih (by
      intro i hi j hj hij hfi hfj
      exact h i (Finset.mem_insert_of_mem hi) j (Finset.mem_insert_of_mem hj) hij hfi hfj) hs
    have hai : a ≠ i := by rintro rfl; exact ha hi
    have horders : (f a).order ≠ (∑ j ∈ s, f j).order := by
      rw [he]
      exact h a (Finset.mem_insert_self a s) i (Finset.mem_insert_of_mem hi) hai hf hfi
    rw [PowerSeries.order_add_of_order_ne _ _ horders]
    rcases le_total (f a).order (∑ j ∈ s, f j).order with hle | hle
    · exact ⟨a, Finset.mem_insert_self a s, hf, min_eq_left hle⟩
    · exact ⟨i, Finset.mem_insert_of_mem hi, hfi, (min_eq_right hle).trans he⟩

/-- Nonzero summands with pairwise distinct orders have nonzero sum. -/
theorem sum_ne_zero_of_pairwise_orders {ι : Type*} (s : Finset ι)
    (f : ι → PowerSeries ℂ)
    (h : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → f i ≠ 0 → f j ≠ 0 →
      (f i).order ≠ (f j).order)
    (hne : ∃ i ∈ s, f i ≠ 0) : ∑ i ∈ s, f i ≠ 0 := by
  classical
  induction s using Finset.induction_on with
  | empty => simp at hne
  | @insert a s ha ih =>
    have hrest : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → f i ≠ 0 → f j ≠ 0 →
        (f i).order ≠ (f j).order := by
      intro i hi j hj hij hfi hfj
      exact h i (Finset.mem_insert_of_mem hi) j (Finset.mem_insert_of_mem hj) hij hfi hfj
    rw [Finset.sum_insert ha]
    by_cases hex : ∃ i ∈ s, f i ≠ 0
    · have hs := ih hrest hex
      by_cases hf : f a = 0
      · simpa [hf] using hs
      obtain ⟨i, hi, hfi, he⟩ := order_sum_mem_of_pairwise s f hrest hs
      have hai : a ≠ i := by rintro rfl; exact ha hi
      have ho : (f a).order ≠ (∑ j ∈ s, f j).order := by
        rw [he]
        exact h a (Finset.mem_insert_self a s) i (Finset.mem_insert_of_mem hi) hai hf hfi
      intro hz
      have hh := PowerSeries.order_add_of_order_ne (f a) (∑ j ∈ s, f j) ho
      rw [hz, PowerSeries.order_zero] at hh
      have hfin : (f a).order ≠ ⊤ := PowerSeries.order_eq_top.not.mpr hf
      exact hfin (le_antisymm le_top (hh ▸ le_min_iff.mp le_rfl).1)
    · have hs : ∑ i ∈ s, f i = 0 := Finset.sum_eq_zero (by
        intro i hi
        by_contra hf
        exact hex ⟨i,hi,hf⟩)
      obtain ⟨i, hi, hfi⟩ := hne
      have hei : i = a := (Finset.mem_insert.mp hi).resolve_right (by
        intro his; exact hex ⟨i,his,hfi⟩)
      subst i
      simpa [hs] using hfi

/-- Coefficients in the parameter subring shift orders by multiples of the multiplicity. -/
theorem order_expand_mul (m : ℕ) (hm : m ≠ 0) (u f : PowerSeries ℂ)
    (hu : u ≠ 0) (a : ℕ) (hf : f.order = a) :
    ((PowerSeries.expand m hm u) * f).order = (m * u.order.toNat + a : ℕ) := by
  rw [PowerSeries.order_mul, PowerSeries.order_expand, hf,
    ← PowerSeries.coe_toNat_order hu]
  simp [nsmul_eq_mul]

/-- A module generated by series of distinct order residues has no other order residues. -/
theorem order_of_parameter_span {ι : Type*} (s : Finset ι)
    (m : ℕ) (hm : m ≠ 0) (u f : ι → PowerSeries ℂ) (a : ι → ℕ)
    (hf : ∀ i ∈ s, (f i).order = a i)
    (ha : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → a i % m ≠ a j % m)
    (n : ℕ) (hn : (∑ i ∈ s, PowerSeries.expand m hm (u i) * f i).order = n) :
    ∃ i ∈ s, ∃ k : ℕ, n = m*k + a i := by
  classical
  let g := fun i => PowerSeries.expand m hm (u i) * f i
  have hu (i : ι) (hg : g i ≠ 0) : u i ≠ 0 := by
    intro h
    apply hg
    simp [g, h]
  have hgord (i : ι) (hi : i ∈ s) (hg : g i ≠ 0) :
      (g i).order = (m * (u i).order.toNat + a i : ℕ) :=
    order_expand_mul m hm (u i) (f i) (hu i hg) (a i) (hf i hi)
  have hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → g i ≠ 0 → g j ≠ 0 →
      (g i).order ≠ (g j).order := by
    intro i hi j hj hij hgi hgj he
    rw [hgord i hi hgi, hgord j hj hgj] at he
    have he' : m * (u i).order.toNat + a i = m * (u j).order.toNat + a j := by
      exact_mod_cast he
    apply ha i hi j hj hij
    simpa using congrArg (fun k => k % m) he'
  have hsum : ∑ i ∈ s, g i ≠ 0 := by
    intro he
    have ht : (∑ i ∈ s, g i).order = ⊤ := by rw [he]; simp
    rw [hn] at ht
    simp at ht
  obtain ⟨i, hi, hgi, he⟩ := order_sum_mem_of_pairwise s g hpair hsum
  refine ⟨i, hi, (u i).order.toNat, ?_⟩
  rw [hgord i hi hgi, hn] at he
  exact_mod_cast he

theorem order_residue_of_parameter_span {ι : Type*} (s : Finset ι)
    (m : ℕ) (hm : m ≠ 0) (u f : ι → PowerSeries ℂ) (a : ι → ℕ)
    (hf : ∀ i ∈ s, (f i).order = a i)
    (ha : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → a i % m ≠ a j % m)
    (n : ℕ) (hn : (∑ i ∈ s, PowerSeries.expand m hm (u i) * f i).order = n) :
    ∃ i ∈ s, n % m = a i % m := by
  obtain ⟨i,hi,k,hk⟩ := order_of_parameter_span s m hm u f a hf ha n hn
  exact ⟨i,hi,by simp [hk]⟩

/-- Distinct order residues give independence over the genuine parameter subring. -/
theorem parameter_relation_eq_zero {ι : Type*} (s : Finset ι)
    (m : ℕ) (hm : m ≠ 0) (u f : ι → PowerSeries ℂ) (a : ι → ℕ)
    (hf : ∀ i ∈ s, (f i).order = a i)
    (ha : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → a i % m ≠ a j % m)
    (hrel : ∑ i ∈ s, PowerSeries.expand m hm (u i) * f i = 0) :
    ∀ i ∈ s, u i = 0 := by
  classical
  let g := fun i => PowerSeries.expand m hm (u i) * f i
  have hu (i : ι) (hg : g i ≠ 0) : u i ≠ 0 := by
    intro h
    apply hg
    simp [g, h]
  have hgord (i : ι) (hi : i ∈ s) (hg : g i ≠ 0) :
      (g i).order = (m * (u i).order.toNat + a i : ℕ) :=
    order_expand_mul m hm (u i) (f i) (hu i hg) (a i) (hf i hi)
  have hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → g i ≠ 0 → g j ≠ 0 →
      (g i).order ≠ (g j).order := by
    intro i hi j hj hij hgi hgj he
    rw [hgord i hi hgi, hgord j hj hgj] at he
    have he' : m * (u i).order.toNat + a i = m * (u j).order.toNat + a j := by
      exact_mod_cast he
    apply ha i hi j hj hij
    simpa using congrArg (fun k => k % m) he'
  intro i hi
  by_contra hui
  have hgi : g i ≠ 0 := by
    intro hz
    have he := order_expand_mul m hm (u i) (f i) hui (a i) (hf i hi)
    change (g i).order = _ at he
    rw [hz, PowerSeries.order_zero] at he
    exact ENat.natCast_ne_top _ he.symm
  exact sum_ne_zero_of_pairwise_orders s g hpair ⟨i,hi,hgi⟩ hrel

end HonestEmbeddingDimension
