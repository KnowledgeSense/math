import HonestEmbeddingDimension.Definitions
import Mathlib.Data.Nat.Prime.Basic
import Mathlib.Data.Finset.Max

namespace HonestEmbeddingDimension
namespace NumericalSemigroup

attribute [local instance] Classical.propDecidable

/-- Cofiniteness supplies a conductor bound independently of a presentation. -/
theorem exists_conductor (S : NumericalSemigroup) :
    ∃ c : ℕ, ∀ n : ℕ, c ≤ n → n ∈ S.monoid := by
  obtain ⟨b, hb⟩ := S.finite_complement.bddAbove
  refine ⟨b + 1, ?_⟩
  intro n hn
  by_contra h
  have := hb h
  omega

/-- The conductor is the actual least integer above which all integers belong to `S`. -/
noncomputable def conductor (S : NumericalSemigroup) : ℕ :=
  Nat.find S.exists_conductor

theorem mem_of_conductor_le (S : NumericalSemigroup) {n : ℕ}
    (hn : S.conductor ≤ n) : n ∈ S.monoid :=
  Nat.find_spec S.exists_conductor n hn

theorem conductor_le (S : NumericalSemigroup) {c : ℕ}
    (hc : ∀ n, c ≤ n → n ∈ S.monoid) : S.conductor ≤ c :=
  Nat.find_min' S.exists_conductor hc

theorem mul_mem {S : NumericalSemigroup} {m : ℕ} (hm : m ∈ S.monoid) (q : ℕ) :
    m * q ∈ S.monoid := by
  simpa [smul_eq_mul, Nat.mul_comm] using S.monoid.nsmul_mem hm q

/-- A positive element is a minimal generator exactly when it is indecomposable. -/
def IsMinimalGenerator (S : NumericalSemigroup) (n : ℕ) : Prop :=
  0 < n ∧ n ∈ S.monoid ∧
    ∀ x ∈ S.monoid, ∀ y ∈ S.monoid, x + y = n → x = 0 ∨ y = 0

/-- The intrinsic set of minimal generators, not a specified surrogate presentation. -/
def minimalGenerators (S : NumericalSemigroup) : Set ℕ := {n | S.IsMinimalGenerator n}

theorem minimalGenerator_of_multiplicity {S : NumericalSemigroup} {m : ℕ}
    (hm : HasMultiplicity S m) : S.IsMinimalGenerator m := by
  refine ⟨hm.1, hm.2.1, ?_⟩
  intro x hx y hy hxy
  by_cases hx0 : x = 0
  · exact Or.inl hx0
  · right
    have := hm.2.2 x hx (by omega)
    omega

/-- Every member is generated by the intrinsic indecomposable elements. -/
theorem closure_minimalGenerators (S : NumericalSemigroup) :
    AddSubmonoid.closure S.minimalGenerators = S.monoid := by
  apply le_antisymm
  · apply AddSubmonoid.closure_le.mpr
    exact fun _ h => h.2.1
  · intro n hn
    induction n using Nat.strong_induction_on with
    | h n ih =>
      by_cases hn0 : n = 0
      · subst n
        exact (AddSubmonoid.closure S.minimalGenerators).zero_mem
      by_cases hmin : S.IsMinimalGenerator n
      · exact AddSubmonoid.subset_closure hmin
      have hdec : ∃ x ∈ S.monoid, ∃ y ∈ S.monoid, x + y = n ∧ x ≠ 0 ∧ y ≠ 0 := by
        simp only [IsMinimalGenerator, show 0 < n from by omega, hn, true_and,
          not_forall, not_or, exists_prop] at hmin
        exact hmin
      obtain ⟨x, hx, y, hy, hxy, hx0, hy0⟩ := hdec
      rw [← hxy]
      exact (AddSubmonoid.closure S.minimalGenerators).add_mem
        (ih x (by omega) hx) (ih y (by omega) hy)

/-- The next element outside any additive submonoid is a genuine minimal generator. -/
theorem minimalGenerator_of_least_outside {S : NumericalSemigroup}
    {T : AddSubmonoid ℕ} {n : ℕ} (hn : n ∈ S.monoid) (hnT : n ∉ T)
    (hmin : ∀ k ∈ S.monoid, k ∉ T → n ≤ k) : S.IsMinimalGenerator n := by
  refine ⟨?_, hn, ?_⟩
  · by_contra h
    have : n = 0 := by omega
    exact hnT (this ▸ T.zero_mem)
  · intro x hx y hy hxy
    by_contra h
    have hx0 : 0 < x := by omega
    have hy0 : 0 < y := by omega
    have hxT : x ∈ T := by
      by_contra hh
      have := hmin x hx hh
      omega
    have hyT : y ∈ T := by
      by_contra hh
      have := hmin y hy hh
      omega
    exact hnT (hxy ▸ T.add_mem hxT hyT)

/-- The Apéry set consists of semigroup members from which one cannot subtract `m`. -/
def apery (S : NumericalSemigroup) (m : ℕ) : Set ℕ :=
  {n | n ∈ S.monoid ∧ (n < m ∨ n - m ∉ S.monoid)}

theorem exists_mem_residue (S : NumericalSemigroup) (m : ℕ) (hm : 0 < m) (r : ℕ) :
    ∃ n, n ∈ S.monoid ∧ n % m = r % m := by
  refine ⟨S.conductor * m + r % m, S.mem_of_conductor_le ?_, ?_⟩
  · have := Nat.le_mul_of_pos_right S.conductor hm
    omega
  · simp

/-- The actual least semigroup element in a prescribed residue class. -/
noncomputable def aperyMin (S : NumericalSemigroup) (m : ℕ) (hm : 0 < m) (r : ℕ) : ℕ :=
  Nat.find (S.exists_mem_residue m hm r)

theorem aperyMin_mem (S : NumericalSemigroup) (m : ℕ) (hm : 0 < m) (r : ℕ) :
    S.aperyMin m hm r ∈ S.monoid :=
  (Nat.find_spec (S.exists_mem_residue m hm r)).1

theorem aperyMin_mod (S : NumericalSemigroup) (m : ℕ) (hm : 0 < m) (r : ℕ) :
    S.aperyMin m hm r % m = r % m :=
  (Nat.find_spec (S.exists_mem_residue m hm r)).2

theorem aperyMin_le {S : NumericalSemigroup} {m r n : ℕ} {hm : 0 < m}
    (hn : n ∈ S.monoid) (hr : n % m = r % m) : S.aperyMin m hm r ≤ n :=
  Nat.find_min' (S.exists_mem_residue m hm r) ⟨hn, hr⟩

theorem mem_of_same_residue_le {S : NumericalSemigroup} {m a b : ℕ}
    (hm : m ∈ S.monoid) (ha : a ∈ S.monoid) (hab : a ≤ b)
    (hr : a % m = b % m) : b ∈ S.monoid := by
  have hdiv : a / m ≤ b / m := Nat.div_le_div_right hab
  have heq : b = a + m * (b / m - a / m) := by
    have ha' := Nat.mod_add_div a m
    have hb' := Nat.mod_add_div b m
    rw [Nat.mul_sub_left_distrib]
    have hmul := Nat.mul_le_mul_left m hdiv
    omega
  rw [heq]
  exact S.monoid.add_mem ha (mul_mem hm _)

theorem mem_iff_aperyMin_le {S : NumericalSemigroup} {m n : ℕ} (hm : 0 < m)
    (hmS : m ∈ S.monoid) : n ∈ S.monoid ↔ S.aperyMin m hm n ≤ n := by
  constructor
  · intro hn
    exact aperyMin_le hn rfl
  · intro hn
    exact mem_of_same_residue_le hmS (S.aperyMin_mem m hm n) hn
      (S.aperyMin_mod m hm n)

@[simp] theorem aperyMin_zero (S : NumericalSemigroup) (m : ℕ) (hm : 0 < m) :
    S.aperyMin m hm 0 = 0 := by
  have := aperyMin_le (hm := hm) S.monoid.zero_mem rfl
  exact Nat.eq_zero_of_le_zero this

theorem aperyMin_eq_of_mod_eq {S : NumericalSemigroup} {m r s : ℕ} {hm : 0 < m}
    (hrs : r % m = s % m) : S.aperyMin m hm r = S.aperyMin m hm s := by
  apply le_antisymm
  · exact aperyMin_le (S.aperyMin_mem m hm s) ((S.aperyMin_mod m hm s).trans hrs.symm)
  · exact aperyMin_le (S.aperyMin_mem m hm r) ((S.aperyMin_mod m hm r).trans hrs)

theorem aperyMin_mem_apery (S : NumericalSemigroup) (m : ℕ) (hm : 0 < m) (r : ℕ) :
    S.aperyMin m hm r ∈ S.apery m := by
  refine ⟨S.aperyMin_mem m hm r, ?_⟩
  by_cases hn : S.aperyMin m hm r < m
  · exact Or.inl hn
  · right
    intro hh
    have hr : (S.aperyMin m hm r - m) % m = r % m := by
      rw [← Nat.mod_eq_sub_mod (by omega)]
      exact S.aperyMin_mod m hm r
    have := aperyMin_le (hm := hm) hh hr
    omega

theorem mem_apery_iff_eq_aperyMin {S : NumericalSemigroup} {m n : ℕ}
    (hm : 0 < m) (hmS : m ∈ S.monoid) :
    n ∈ S.apery m ↔ n = S.aperyMin m hm n := by
  constructor
  · rintro ⟨hn, hnsub⟩
    have hle := aperyMin_le (hm := hm) hn rfl
    by_contra hne
    have hlt : S.aperyMin m hm n < n := by omega
    have hmod := S.aperyMin_mod m hm n
    have hgap : S.aperyMin m hm n + m ≤ n := Nat.ModEq.add_le_of_lt hmod hlt
    have hmle : m ≤ n := by omega
    have hsub : n - m ∈ S.monoid := by
      apply mem_of_same_residue_le hmS (S.aperyMin_mem m hm n) (by omega)
      rw [← Nat.mod_eq_sub_mod hmle]
      exact hmod
    rcases hnsub with hh | hh
    · omega
    · exact hh hsub
  · intro hn
    rw [hn]
    exact S.aperyMin_mem_apery m hm n

theorem apery_eq_of_mod_eq {S : NumericalSemigroup} {m a b : ℕ}
    (hm : 0 < m) (hmS : m ∈ S.monoid) (ha : a ∈ S.apery m) (hb : b ∈ S.apery m)
    (hr : a % m = b % m) : a = b := by
  rw [(mem_apery_iff_eq_aperyMin hm hmS).mp ha,
    (mem_apery_iff_eq_aperyMin hm hmS).mp hb]
  exact aperyMin_eq_of_mod_eq hr

theorem minimalGenerator_mem_apery {S : NumericalSemigroup} {m n : ℕ}
    (hm : 0 < m) (hmS : m ∈ S.monoid) (hn : S.IsMinimalGenerator n) (hne : n ≠ m) :
    n ∈ S.apery m := by
  refine ⟨hn.2.1, ?_⟩
  by_cases hnm : n < m
  · exact Or.inl hnm
  · right
    intro hsub
    have := hn.2.2 m hmS (n - m) hsub (by omega)
    omega

theorem minimalGenerator_mod_ne_zero {S : NumericalSemigroup} {m n : ℕ}
    (hm : 0 < m) (hmS : m ∈ S.monoid) (hn : S.IsMinimalGenerator n) (hne : n ≠ m) :
    n % m ≠ 0 := by
  intro hzero
  have hap := minimalGenerator_mem_apery hm hmS hn hne
  have heq := (mem_apery_iff_eq_aperyMin hm hmS).mp hap
  have hz : S.aperyMin m hm n = 0 := by
    rw [aperyMin_eq_of_mod_eq (s := 0) (by simpa using hzero), aperyMin_zero]
  have hpos := hn.1
  omega

theorem minimalGenerators_residue_injective {S : NumericalSemigroup} {m : ℕ}
    (hm : HasMultiplicity S m) : Set.InjOn (fun n : ℕ => n % m) S.minimalGenerators := by
  intro a ha b hb hr
  by_cases ham : a = m
  · subst a
    by_cases hbm : b = m
    · exact hbm.symm
    have := minimalGenerator_mod_ne_zero hm.1 hm.2.1 hb hbm
    simp only [Nat.mod_self] at hr
    omega
  by_cases hbm : b = m
  · subst b
    have := minimalGenerator_mod_ne_zero hm.1 hm.2.1 ha ham
    simp only [Nat.mod_self] at hr
    contradiction
  exact apery_eq_of_mod_eq hm.1 hm.2.1
    (minimalGenerator_mem_apery hm.1 hm.2.1 ha ham)
    (minimalGenerator_mem_apery hm.1 hm.2.1 hb hbm) hr

/-- At multiplicity five every minimal generator other than five is coprime to five. -/
theorem minimalGenerator_coprime_five {S : NumericalSemigroup} (hm : HasMultiplicity S 5)
    {n : ℕ} (hn : S.IsMinimalGenerator n) (hne : n ≠ 5) : Nat.Coprime n 5 := by
  rw [Nat.coprime_comm, Nat.prime_five.coprime_iff_not_dvd]
  exact fun hd => minimalGenerator_mod_ne_zero hm.1 hm.2.1 hn hne (Nat.mod_eq_zero_of_dvd hd)

/-- The finite-complement condition forces an element in every residue class. -/
theorem exists_not_dvd (S : NumericalSemigroup) {m : ℕ} (hm : 1 < m) :
    ∃ n ∈ S.monoid, ¬m ∣ n := by
  obtain ⟨n, hn, hr⟩ := S.exists_mem_residue m (by omega) 1
  refine ⟨n, hn, ?_⟩
  intro hd
  rw [Nat.mod_eq_zero_of_dvd hd, Nat.mod_eq_of_lt hm] at hr
  omega

/-- The first element not divisible by the multiplicity exists intrinsically. -/
noncomputable def firstNonmultiple (S : NumericalSemigroup) (m : ℕ) (hm : 1 < m) : ℕ :=
  Nat.find (S.exists_not_dvd hm)

theorem firstNonmultiple_spec (S : NumericalSemigroup) (m : ℕ) (hm : 1 < m) :
    S.firstNonmultiple m hm ∈ S.monoid ∧ ¬m ∣ S.firstNonmultiple m hm :=
  Nat.find_spec (S.exists_not_dvd hm)

theorem firstNonmultiple_le {S : NumericalSemigroup} {m n : ℕ} {hm : 1 < m}
    (hn : n ∈ S.monoid) (hnd : ¬m ∣ n) : S.firstNonmultiple m hm ≤ n :=
  Nat.find_min' (S.exists_not_dvd hm) ⟨hn, hnd⟩

@[simp] theorem mem_multiples_iff_dvd (m n : ℕ) :
    n ∈ AddSubmonoid.multiples m ↔ m ∣ n := by
  rw [AddSubmonoid.mem_multiples_iff]
  simp only [smul_eq_mul, Nat.mul_comm, dvd_def, eq_comm]

theorem firstNonmultiple_isMinimalGenerator (S : NumericalSemigroup) (m : ℕ)
    (hm : 1 < m) : S.IsMinimalGenerator (S.firstNonmultiple m hm) := by
  apply minimalGenerator_of_least_outside (T := AddSubmonoid.multiples m)
    (S.firstNonmultiple_spec m hm).1
  · simpa using (S.firstNonmultiple_spec m hm).2
  · intro k hk hkT
    exact firstNonmultiple_le hk (by simpa using hkT)

theorem firstNonmultiple_coprime_five (S : NumericalSemigroup) :
    Nat.Coprime 5 (S.firstNonmultiple 5 (by omega)) := by
  exact Nat.prime_five.coprime_iff_not_dvd.mpr (S.firstNonmultiple_spec 5 (by omega)).2

/-- Minimal generators have at most one representative of each residue. -/
theorem finite_minimalGenerators {S : NumericalSemigroup} {m : ℕ}
    (hm : HasMultiplicity S m) : S.minimalGenerators.Finite := by
  exact (Set.finite_Iio m).of_injOn
    (fun n _ => Nat.mod_lt n hm.1) (minimalGenerators_residue_injective hm)

theorem minimalGenerators_ncard_le_multiplicity {S : NumericalSemigroup} {m : ℕ}
    (hm : HasMultiplicity S m) : S.minimalGenerators.ncard ≤ m := by
  let f : ℕ → Fin m := fun n => ⟨n % m, Nat.mod_lt n hm.1⟩
  have hh := Set.ncard_le_ncard_of_injOn f
    (s := S.minimalGenerators) (t := Set.univ)
    (fun _ _ => Set.mem_univ _) (by
      intro a ha b hb hab
      exact minimalGenerators_residue_injective hm ha hb (congrArg Fin.val hab))
    (Set.finite_univ)
  simpa using hh

theorem finite_apery (S : NumericalSemigroup) (m : ℕ) : (S.apery m).Finite := by
  apply (Set.finite_Iio (S.conductor + m)).subset
  intro n hn
  change n < S.conductor + m
  by_contra h
  have hnm : m ≤ n := by omega
  have hh := S.mem_of_conductor_le (n := n - m) (by omega)
  rcases hn.2 with hlt | hgap
  · omega
  · exact hgap hh

theorem zero_mem_apery (S : NumericalSemigroup) {m : ℕ} (hm : 0 < m) :
    0 ∈ S.apery m := ⟨S.monoid.zero_mem, Or.inl hm⟩

/-- The largest element of the actual finite Apéry set. -/
noncomputable def aperyMax (S : NumericalSemigroup) (m : ℕ) (hm : 0 < m) : ℕ :=
  (S.finite_apery m).toFinset.max' ⟨0, (S.finite_apery m).mem_toFinset.mpr
    (S.zero_mem_apery hm)⟩

theorem aperyMax_mem (S : NumericalSemigroup) (m : ℕ) (hm : 0 < m) :
    S.aperyMax m hm ∈ S.apery m := by
  apply (S.finite_apery m).mem_toFinset.mp
  exact Finset.max'_mem _ _

theorem le_aperyMax {S : NumericalSemigroup} {m n : ℕ} {hm : 0 < m}
    (hn : n ∈ S.apery m) : n ≤ S.aperyMax m hm :=
  Finset.le_max' _ _ ((S.finite_apery m).mem_toFinset.mpr hn)

/-- Selmer's conductor formula, with natural subtraction made explicit. -/
theorem conductor_eq_of_apery_max {S : NumericalSemigroup} {m W : ℕ}
    (hm : 0 < m) (hmS : m ∈ S.monoid) (hW : W ∈ S.apery m)
    (hmax : ∀ w ∈ S.apery m, w ≤ W) (hmW : m ≤ W) :
    S.conductor = W + 1 - m := by
  apply le_antisymm
  · apply S.conductor_le
    intro n hn
    by_contra hnot
    have hlt : n < S.aperyMin m hm n := by
      have := (mem_iff_aperyMin_le hm hmS).not.mp hnot
      omega
    have hr := (S.aperyMin_mod m hm n).symm
    have hgap := Nat.ModEq.add_le_of_lt hr hlt
    have hbound := hmax _ (S.aperyMin_mem_apery m hm n)
    omega
  · have hgap : W - m ∉ S.monoid := by
      rcases hW.2 with hh | hh
      · omega
      · exact hh
    have : ¬S.conductor ≤ W - m := fun h => hgap (S.mem_of_conductor_le h)
    omega

theorem multiplicity_le_aperyMax {S : NumericalSemigroup} {m : ℕ}
    (hm : HasMultiplicity S m) (hm1 : 1 < m) : m ≤ S.aperyMax m hm.1 := by
  have hr := S.aperyMin_mod m hm.1 1
  have hpos : 0 < S.aperyMin m hm.1 1 := by
    rw [Nat.mod_eq_of_lt hm1] at hr
    by_contra hh
    have : S.aperyMin m hm.1 1 = 0 := by omega
    simp [this] at hr
  exact (hm.2.2 _ (S.aperyMin_mem m hm.1 1) hpos).trans
    (le_aperyMax (S.aperyMin_mem_apery m hm.1 1))

theorem conductor_eq_aperyMax {S : NumericalSemigroup} {m : ℕ}
    (hm : HasMultiplicity S m) (hm1 : 1 < m) :
    S.conductor = S.aperyMax m hm.1 + 1 - m :=
  conductor_eq_of_apery_max hm.1 hm.2.1 (S.aperyMax_mem m hm.1)
    (fun _ hw => le_aperyMax hw) (multiplicity_le_aperyMax hm hm1)

/-- The original multiplicity-five conductor identity. -/
theorem conductor_eq_aperyMax_sub_four {S : NumericalSemigroup}
    (hm : HasMultiplicity S 5) : S.conductor = S.aperyMax 5 hm.1 - 4 := by
  rw [conductor_eq_aperyMax hm (by omega)]
  have := multiplicity_le_aperyMax hm (by omega)
  omega

/-- Kunz's inequalities follow from closure under addition. -/
theorem aperyMin_add_le (S : NumericalSemigroup) (m : ℕ) (hm : 0 < m) (r s : ℕ) :
    S.aperyMin m hm (r + s) ≤ S.aperyMin m hm r + S.aperyMin m hm s := by
  apply aperyMin_le (S.monoid.add_mem (S.aperyMin_mem m hm r) (S.aperyMin_mem m hm s))
  simp [Nat.add_mod, S.aperyMin_mod]

/-- Each summand of a decomposition of an Apéry element is itself in the Apéry set. -/
theorem summand_mem_apery {S : NumericalSemigroup} {m x y : ℕ}
    (hx : x ∈ S.monoid) (hy : y ∈ S.monoid) (hxy : x + y ∈ S.apery m) :
    x ∈ S.apery m := by
  refine ⟨hx, ?_⟩
  by_cases hxm : x < m
  · exact Or.inl hxm
  · right
    intro hsub
    have hsum : x + y - m ∈ S.monoid := by
      have heq : x + y - m = (x - m) + y := by omega
      rw [heq]
      exact S.monoid.add_mem hsub hy
    rcases hxy.2 with hh | hh
    · omega
    · exact hh hsum

/-- Every nonminimal nonzero Apéry element splits into two nonzero Apéry elements. -/
theorem exists_apery_decomposition {S : NumericalSemigroup} {m n : ℕ}
    (hn : n ∈ S.apery m) (hn0 : 0 < n) (hmin : ¬S.IsMinimalGenerator n) :
    ∃ x ∈ S.apery m, ∃ y ∈ S.apery m, 0 < x ∧ 0 < y ∧ x + y = n := by
  have hdec : ∃ x ∈ S.monoid, ∃ y ∈ S.monoid, x + y = n ∧ x ≠ 0 ∧ y ≠ 0 := by
    simpa only [IsMinimalGenerator, hn0, hn.1, true_and, not_forall, not_or,
      exists_prop] using hmin
  obtain ⟨x, hx, y, hy, hxy, hx0, hy0⟩ := hdec
  refine ⟨x, summand_mem_apery hx hy (hxy ▸ hn), y, ?_, by omega, by omega, hxy⟩
  apply summand_mem_apery hy hx
  simpa [Nat.add_comm] using hxy ▸ hn

/-- A decomposable Apéry minimum is an attained minimum of sums of nonzero residue minima. -/
theorem aperyMin_decomposition {S : NumericalSemigroup} {m r : ℕ}
    (hm : 0 < m) (hmS : m ∈ S.monoid) (hr : r % m ≠ 0)
    (hmin : ¬S.IsMinimalGenerator (S.aperyMin m hm r)) :
    ∃ s < m, ∃ t < m, s ≠ 0 ∧ t ≠ 0 ∧ (s + t) % m = r % m ∧
      S.aperyMin m hm r = S.aperyMin m hm s + S.aperyMin m hm t ∧
      ∀ u v, (u + v) % m = r % m →
        S.aperyMin m hm r ≤ S.aperyMin m hm u + S.aperyMin m hm v := by
  have hnr := S.aperyMin_mod m hm r
  have hn0 : 0 < S.aperyMin m hm r := by
    by_contra hh
    have : S.aperyMin m hm r = 0 := by omega
    simp [this] at hnr
    exact hr hnr.symm
  obtain ⟨x, hx, y, hy, hx0, hy0, hxy⟩ :=
    exists_apery_decomposition (S.aperyMin_mem_apery m hm r) hn0 hmin
  have hxeq : x = S.aperyMin m hm (x % m) := by
    rw [aperyMin_eq_of_mod_eq (r := x % m) (s := x) (by simp)]
    exact (mem_apery_iff_eq_aperyMin hm hmS).mp hx
  have hyeq : y = S.aperyMin m hm (y % m) := by
    rw [aperyMin_eq_of_mod_eq (r := y % m) (s := y) (by simp)]
    exact (mem_apery_iff_eq_aperyMin hm hmS).mp hy
  refine ⟨x % m, Nat.mod_lt x hm, y % m, Nat.mod_lt y hm, ?_, ?_, ?_, ?_, ?_⟩
  · intro hh
    rw [hh, aperyMin_zero] at hxeq
    omega
  · intro hh
    rw [hh, aperyMin_zero] at hyeq
    omega
  · simpa [← Nat.add_mod, hxy] using hnr
  · omega
  · intro u v huv
    rw [← aperyMin_eq_of_mod_eq huv]
    exact S.aperyMin_add_le m hm u v

end NumericalSemigroup
end HonestEmbeddingDimension
