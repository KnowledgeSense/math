import FourGeneratedSemigroups.DefiningIdeal
import Mathlib.Algebra.Polynomial.Basis

noncomputable section
namespace FourGeneratedSemigroups

/-- All binomials between factorizations of the same semigroup element. -/
def relationBinomials (K : Type*) [Field K] (d : Fin 4 → ℕ) :
    Set (MvPolynomial (Fin 4) K) :=
  {f | ∃ a b : Factorization, factorizationMap d a = factorizationMap d b ∧
    f = MvPolynomial.monomial a 1 - MvPolynomial.monomial b 1}

noncomputable def representativeFactorization (d : Fin 4 → ℕ) (n : ℕ) : Factorization := by
  classical
  exact if h : ∃ a, factorizationMap d a = n then Classical.choose h else 0

lemma representativeFactorization_weight (d : Fin 4 → ℕ) (a : Factorization) :
    factorizationMap d (representativeFactorization d (factorizationMap d a)) =
      factorizationMap d a := by
  classical
  have h : ∃ b, factorizationMap d b = factorizationMap d a := ⟨a,rfl⟩
  simp only [representativeFactorization,dite_eq_left h]
  exact Classical.choose_spec h

/-- A linear normal-form section, choosing one monomial in every occurring degree. -/
noncomputable def binomialNormalForm (K : Type*) [Field K] (d : Fin 4 → ℕ) :
    Polynomial K →ₗ[K]
      (MvPolynomial (Fin 4) K ⧸ Ideal.span (relationBinomials K d)) :=
  (Polynomial.basisMonomials K).constr K (fun n =>
    Ideal.Quotient.mk _ (MvPolynomial.monomial (representativeFactorization d n) 1))

lemma binomialNormalForm_curveMap (K : Type*) [Field K] (d : Fin 4 → ℕ) :
    (binomialNormalForm K d).comp (curveMap K d).toLinearMap =
      (Ideal.Quotient.mkₐ K (Ideal.span (relationBinomials K d))).toLinearMap := by
  apply (MvPolynomial.basisMonomials (Fin 4) K).ext
  intro a
  simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, MvPolynomial.coe_basisMonomials]
  rw [curveMap_monomial, ← Polynomial.monomial_one_right_eq_X_pow]
  change (Polynomial.basisMonomials K).constr K _ ((Polynomial.basisMonomials K) _) = _
  rw [Module.Basis.constr_basis]
  apply Ideal.Quotient.eq.mpr
  apply Ideal.subset_span
  exact ⟨_,a,representativeFactorization_weight d a,rfl⟩

/-- The defining ideal is generated by precisely the actual equal-weight binomial relations. -/
theorem definingIdeal_eq_binomial_span (K : Type*) [Field K] (d : Fin 4 → ℕ) :
    definingIdeal K d = Ideal.span (relationBinomials K d) := by
  apply le_antisymm
  · intro f hf
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    have he := LinearMap.congr_fun (binomialNormalForm_curveMap K d) f
    have hf0 : curveMap K d f = 0 := hf
    simpa [hf0] using he.symm
  · rw [Ideal.span_le]
    rintro f ⟨a,b,hab,rfl⟩
    exact (binomial_mem_definingIdeal_iff K d a b).mpr hab

end FourGeneratedSemigroups
