import FourGeneratedSemigroups.LowerBound
import FourGeneratedSemigroups.MinimalPresentationCardinality

noncomputable section
namespace FourGeneratedSemigroups

/-- The main relation-type bounds for an actual numerical semigroup minimally
generated by four positive integers. The type counts its actual
pseudo-Frobenius numbers, and the relation number is the minimum cardinality
of a presentation of its actual factorization congruence. -/
theorem type_and_relations {S : NumericalSemigroup} (G : FourGenerated S) :
    S.type+1≤presentationNumber G.generators ∧
      presentationNumber G.generators≤2*S.type+3 :=
  ⟨type_add_one_le_presentationNumber G,presentationNumber_le_twice_type_add_three G⟩

/-- Equivalently, every inclusion-minimal presentation satisfies the two
bounds. No choice of ordering, staircase, or presentation is assumed. -/
theorem minimal_presentation_type_and_relations {S : NumericalSemigroup}
    (G : FourGenerated S) (R : Finset (Factorization×Factorization))
    (hR : IsMinimalPresentation G.generators R) :
    S.type+1≤R.card ∧ R.card≤2*S.type+3 := by
  rw [minimalPresentation_card_eq_presentationNumber G.generators G.positive R hR]
  exact type_and_relations G

/-- The lower bound holds for every presentation, including nonminimal ones. -/
theorem presentation_type_lower_bound {S : NumericalSemigroup}
    (G : FourGenerated S) (R : Finset (Factorization×Factorization))
    (hR : IsPresentation G.generators R) : S.type+1≤R.card :=
  (type_add_one_le_presentationNumber G).trans (presentationNumber_le G.generators R hR)

end FourGeneratedSemigroups
