import FourGeneratedSemigroups.BinomialKernel
import Mathlib.Tactic.Ring

noncomputable section
namespace FourGeneratedSemigroups

/-- Binomial equations associated with a finite presentation. -/
def presentationBinomials (K : Type*) [Field K] (R : Finset (Factorization × Factorization)) :
    Set (MvPolynomial (Fin 4) K) :=
  (fun ab : Factorization × Factorization => MvPolynomial.monomial ab.1 1-MvPolynomial.monomial ab.2 1) '' (R : Set (Factorization × Factorization))

lemma binomial_mem_span_of_congruence (K : Type*) [Field K]
    (R : Finset (Factorization × Factorization)) {a b : Factorization}
    (h : addConGen (fun a b => (a,b) ∈ R) a b) :
    MvPolynomial.monomial a (1 : K)-MvPolynomial.monomial b 1 ∈
      Ideal.span (presentationBinomials K R) := by
  change AddConGen.Rel _ a b at h
  induction h with
  | of a b hab => exact Ideal.subset_span ⟨(a,b),hab,rfl⟩
  | refl a => simp
  | symm h ih => simpa only [neg_sub] using (Ideal.span (presentationBinomials K R)).neg_mem ih
  | trans h1 h2 ih1 ih2 =>
    simpa only [sub_add_sub_cancel] using (Ideal.span (presentationBinomials K R)).add_mem ih1 ih2
  | @add w x y z h1 h2 ih1 ih2 =>
    have hleft := (Ideal.span (presentationBinomials K R)).mul_mem_left
      (MvPolynomial.monomial y 1) ih1
    have hright := (Ideal.span (presentationBinomials K R)).mul_mem_left
      (MvPolynomial.monomial x 1) ih2
    have hh := (Ideal.span (presentationBinomials K R)).add_mem hleft hright
    convert hh using 1 ; simp [mul_sub,MvPolynomial.monomial_mul_monomial,add_comm]

/-- A genuine semigroup presentation yields generators of the actual polynomial kernel. -/
theorem definingIdeal_eq_presentation_span (K : Type*) [Field K] (d : Fin 4 → ℕ)
    (R : Finset (Factorization × Factorization)) (hR : IsPresentation d R) :
    definingIdeal K d = Ideal.span (presentationBinomials K R) := by
  apply le_antisymm
  · rw [definingIdeal_eq_binomial_span,Ideal.span_le]
    rintro f ⟨a,b,hab,rfl⟩
    apply binomial_mem_span_of_congruence K R
    rw [hR]
    exact hab
  · rw [Ideal.span_le]
    rintro f ⟨⟨a,b⟩,hab,rfl⟩
    apply (binomial_mem_definingIdeal_iff K d a b).mpr
    have h : addConGen (fun a b => (a,b) ∈ R) a b := AddConGen.Rel.of a b hab
    rw [hR] at h
    exact h

/-- The monoid-algebra map induced by a genuine exponent congruence. -/
def congruenceAlgebraMap (K : Type*) [Field K] (C : AddCon Factorization) :
    MvPolynomial (Fin 4) K →ₐ[K] AddMonoidAlgebra K C.Quotient :=
  AddMonoidAlgebra.mapDomainAlgHom K K C.mk'

@[simp] lemma congruenceAlgebraMap_monomial (K : Type*) [Field K]
    (C : AddCon Factorization) (a : Factorization) :
    congruenceAlgebraMap K C (MvPolynomial.monomial a 1) =
      AddMonoidAlgebra.single (C.mk' a) 1 := by
  simp [congruenceAlgebraMap,MvPolynomial.monomial]

/-- Polynomial ideal membership cannot identify more monomials than the
additive congruence generated by the proposed relations. -/
theorem congruence_of_binomial_mem_span (K : Type*) [Field K]
    (R : Finset (Factorization × Factorization)) {a b : Factorization}
    (h : MvPolynomial.monomial a (1 : K)-MvPolynomial.monomial b 1 ∈
      Ideal.span (presentationBinomials K R)) :
    addConGen (fun a b => (a,b) ∈ R) a b := by
  let C := addConGen (fun a b : Factorization => (a,b) ∈ R)
  have hle : Ideal.span (presentationBinomials K R) ≤ RingHom.ker (congruenceAlgebraMap K C) := by
    rw [Ideal.span_le]
    rintro f ⟨⟨x,y⟩,hxy,rfl⟩
    have he : C.mk' x=C.mk' y := C.eq.mpr (AddConGen.Rel.of x y hxy)
    simp [RingHom.mem_ker,he]
  have hh := hle h
  rw [RingHom.mem_ker,map_sub,sub_eq_zero,congruenceAlgebraMap_monomial,
    congruenceAlgebraMap_monomial] at hh
  have he : C.mk' a=C.mk' b := by
    have hcoeff := congrArg AddMonoidAlgebra.coeff hh
    simpa [Finsupp.single_eq_single_iff] using hcoeff
  exact C.eq.mp he

/-- Finite congruence presentations and binomial generators of the actual
curve ideal are equivalent, over every field. -/
theorem isPresentation_iff_definingIdeal_eq_span (K : Type*) [Field K]
    (d : Fin 4 → ℕ) (R : Finset (Factorization × Factorization)) :
    IsPresentation d R ↔ definingIdeal K d = Ideal.span (presentationBinomials K R) := by
  constructor
  · exact definingIdeal_eq_presentation_span K d R
  · intro hR
    apply AddCon.ext
    intro a b
    constructor
    · intro hab
      have hm := binomial_mem_span_of_congruence K R hab
      rw [← hR] at hm
      exact (binomial_mem_definingIdeal_iff K d a b).mp hm
    · intro hab
      apply congruence_of_binomial_mem_span K R
      rw [← hR]
      exact (binomial_mem_definingIdeal_iff K d a b).mpr hab

end FourGeneratedSemigroups
